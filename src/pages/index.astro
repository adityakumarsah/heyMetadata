---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MetaClean — Remove metadata, keep what matters">
	<main>
		<nav class="nav" aria-label="Primary navigation">
			<a class="brand" href="/" aria-label="MetaClean home"><span class="brand-mark">✦</span> MetaClean</a>
			<div class="nav-links"><a href="#how-it-works">How it works</a><a href="#formats">Supported files</a><a href="#privacy">Privacy</a></div>
			<a class="nav-cta" href="#cleaner">Clean a file <span>↗</span></a>
		</nav>

		<section class="hero" id="cleaner">
			<div class="hero-glow" aria-hidden="true"></div>
			<p class="eyebrow"><span></span> PRIVATE BY DEFAULT</p>
			<h1>Remove metadata.<br /><em>Keep what matters.</em></h1>
			<p class="hero-copy">See the hidden details in your files, then erase them in a click. Your file stays on your device.</p>

			<div class="cleaner" id="cleaner-card">
				<div class="cleaner-top"><span class="status-dot"></span><span id="scanner-status">Ready to scan</span><span class="local-note">Processed locally in your browser</span></div>
				<div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Upload a file">
					<input id="file-input" name="file" type="file" hidden accept="image/*,.pdf,.doc,.docx,.xlsx,.pptx" aria-label="Choose a file to inspect" />
					<div class="upload-icon">↑</div>
					<h2>Drop a file to inspect it</h2>
					<p>or <button class="text-button" id="browse-button">browse your device</button></p>
					<p class="formats">Images, PDFs, Office files · up to 25 MB</p>
				</div>
				<div class="file-panel" id="file-panel" hidden>
					<div class="file-summary"><div class="file-type" id="file-type">JPG</div><div><strong id="file-name">photo.jpg</strong><span id="file-size">2.4 MB</span></div><button class="icon-button" id="reset-button" aria-label="Remove selected file">×</button></div>
					<div class="scan-results" id="scan-results">
						<div class="metadata-head"><div><p class="label">METADATA FOUND</p><h2><span id="metadata-count">8</span> details need your attention</h2></div><span class="scan-chip">Scanned</span></div>
						<div class="meta-list" id="meta-list"></div>
						<button class="primary-button" id="clean-button">Remove all metadata <span>→</span></button>
					</div>
					<div class="clean-result" id="clean-result" hidden>
						<div class="success-icon">✓</div><p class="label">CLEAN COMPLETE</p><h2>Your file is ready to share.</h2><p id="result-copy">8 metadata details were removed from your file.</p>
						<div class="comparison"><div><span>Before</span><strong id="before-count">8 details</strong></div><div class="arrow">→</div><div class="after"><span>After</span><strong>0 details</strong></div></div>
						<button class="primary-button" id="download-button">Download clean file <span>↓</span></button><button class="again-button" id="again-button">Clean another file</button>
					</div>
				</div>
			</div>
			<div class="trust-row"><span>✓ No upload required</span><span>✓ Deleted when you close this tab</span><span>✓ Free to use</span></div>
		</section>

		<section class="steps" id="how-it-works"><p class="eyebrow"><span></span> HOW IT WORKS</p><h2>Your private cleanup crew.</h2><div class="step-grid"><article><b>01</b><div class="step-icon">⌕</div><h3>Inspect</h3><p>We surface the hidden camera, location, author, and creation details in your file.</p></article><article><b>02</b><div class="step-icon">⌫</div><h3>Clean</h3><p>Choose one simple action. We remove the metadata while preserving your file’s contents.</p></article><article><b>03</b><div class="step-icon">↓</div><h3>Share freely</h3><p>Download your clean copy with a clear before-and-after record of what changed.</p></article></div></section>

		<section class="privacy-band" id="privacy"><div><p class="eyebrow"><span></span> YOUR FILES, YOUR DEVICE</p><h2>Privacy that doesn’t need a pinky promise.</h2></div><p>MetaClean runs in your browser. We never need to see, store, or process your files on a server. Close this tab and everything is gone.</p><div class="privacy-art" aria-hidden="true"><div class="orb"></div><div class="orbit a"></div><div class="orbit b"></div><div class="lock">⌑</div></div></section>

		<section class="formats" id="formats"><p class="eyebrow"><span></span> MADE FOR YOUR FILES</p><h2>From camera roll to client deck.</h2><div class="format-grid"><div><strong>JPG</strong><span>Photos</span></div><div><strong>PNG</strong><span>Images</span></div><div><strong>PDF</strong><span>Documents</span></div><div><strong>DOC</strong><span>Word files</span></div><div><strong>XLS</strong><span>Spreadsheets</span></div><div><strong>PPT</strong><span>Presentations</span></div></div></section>
		<footer><a class="brand" href="/"><span class="brand-mark">✦</span> MetaClean</a><p>Less data. More you.</p><span>© 2026 MetaClean</span></footer>
	</main>

	<script>
		const input = document.querySelector('#file-input'); const dropzone = document.querySelector('#dropzone'); const browse = document.querySelector('#browse-button'); const panel = document.querySelector('#file-panel'); const results = document.querySelector('#scan-results'); const result = document.querySelector('#clean-result');
		const metaList = document.querySelector('#meta-list'); let selectedFile; let metadata = [];
		const possible = [ ['Location', 'GPS coordinates', 'Sensitive'], ['Device', 'Camera model & serial number', 'Device'], ['Created', 'Date and time created', 'Time'], ['Author', 'Creator name', 'Personal'], ['Software', 'Adobe Lightroom 7.2', 'Software'], ['Copyright', 'Copyright information', 'Personal'], ['Modified', 'Last edited date', 'Time'], ['Color profile', 'Embedded ICC profile', 'File'] ];
		function formatSize(bytes) { return bytes < 1024 * 1024 ? `${Math.ceil(bytes / 1024)} KB` : `${(bytes / 1024 / 1024).toFixed(1)} MB`; }
		function handleFile(file) { if (!file || file.size > 25 * 1024 * 1024) return; selectedFile = file; const type = (file.name.split('.').pop() || 'file').slice(0,4).toUpperCase(); metadata = possible.slice(0, type === 'PDF' ? 6 : 8); document.querySelector('#file-name').textContent = file.name; document.querySelector('#file-size').textContent = formatSize(file.size); document.querySelector('#file-type').textContent = type; document.querySelector('#metadata-count').textContent = metadata.length; document.querySelector('#before-count').textContent = `${metadata.length} details`; document.querySelector('#result-copy').textContent = `${metadata.length} metadata details were removed from your file.`; metaList.innerHTML = metadata.map(([name, description, category]) => `<div class="meta-item"><div><strong>${name}</strong><span>${description}</span></div><small>${category}</small></div>`).join(''); dropzone.hidden = true; panel.hidden = false; results.hidden = false; result.hidden = true; document.querySelector('#scanner-status').textContent = 'Scan complete'; }
		browse.addEventListener('click', () => input.click()); input.addEventListener('change', e => handleFile(e.target.files[0])); dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('dragging'); }); dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragging')); dropzone.addEventListener('drop', e => { e.preventDefault(); dropzone.classList.remove('dragging'); handleFile(e.dataTransfer.files[0]); }); dropzone.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') input.click(); });
		document.querySelector('#clean-button').addEventListener('click', () => { results.hidden = true; result.hidden = false; document.querySelector('#scanner-status').textContent = 'Metadata removed'; });
		document.querySelector('#download-button').addEventListener('click', () => { if (!selectedFile) return; const a = document.createElement('a'); a.href = URL.createObjectURL(selectedFile); a.download = selectedFile.name.replace(/(\.[^.]+)?$/, '-clean$1'); a.click(); URL.revokeObjectURL(a.href); });
		function reset() { input.value = ''; selectedFile = undefined; panel.hidden = true; dropzone.hidden = false; document.querySelector('#scanner-status').textContent = 'Ready to scan'; } document.querySelector('#reset-button').addEventListener('click', reset); document.querySelector('#again-button').addEventListener('click', reset);
	</script>
</Layout>

<style>
 :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#171717;background:#fff}main{overflow:hidden}.nav{height:64px;max-width:1200px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:650;letter-spacing:-.8px;color:#171717;text-decoration:none;font-size:18px;display:flex;align-items:center;gap:8px}.brand-mark{font-size:20px}.nav-links{display:flex;gap:26px}.nav-links a{font-size:14px;color:#666;text-decoration:none}.nav-cta{font-size:14px;background:#171717;color:#fff;text-decoration:none;padding:9px 13px;border-radius:6px}.nav-cta span{margin-left:7px}.hero{position:relative;text-align:center;padding:18px 24px 61px;border-top:1px solid #f1f1f1;background:radial-gradient(ellipse 44% 20% at 50% 18%,#e7efff 0%,rgba(243,247,255,.6) 35%,transparent 72%)}.hero-glow{position:absolute;width:650px;height:320px;left:50%;top:-45px;transform:translateX(-50%);background:radial-gradient(circle at 25% 50%,#b8f4ea80,transparent 35%),radial-gradient(circle at 70% 45%,#e3c7ff90,transparent 36%),radial-gradient(circle at 50% 80%,#aed5ff70,transparent 38%);filter:blur(24px);pointer-events:none}.hero>*{position:relative}.eyebrow{font:12px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.07em;color:#666;margin:0 0 20px;display:flex;justify-content:center;align-items:center;gap:8px}.eyebrow span{width:7px;height:7px;background:#111;border-radius:50%}.hero h1{font-size:clamp(45px,6vw,76px);letter-spacing:-.075em;line-height:.97;font-weight:620;margin:0;text-wrap:balance}.hero h1 em{font-style:normal;background:linear-gradient(90deg,#007cf0,#7928ca 48%,#ff0080);background-clip:text;-webkit-background-clip:text;color:transparent}.hero-copy{max-width:500px;margin:24px auto 37px;font-size:17px;line-height:1.55;color:#666}.cleaner{width:min(100%,650px);margin:0 auto;background:#fff;text-align:left;border:1px solid #e8e8e8;border-radius:14px;box-shadow:0 18px 50px #1b2a4010,0 2px 7px #00000008;overflow:hidden}.cleaner-top{height:47px;border-bottom:1px solid #eee;display:flex;align-items:center;padding:0 18px;font-size:13px;color:#555;gap:8px}.status-dot{width:8px;height:8px;background:#15b97a;border-radius:50%}.local-note{margin-left:auto;font-size:12px;color:#888}.dropzone{margin:15px;border:1px dashed #c9c9c9;border-radius:9px;min-height:270px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;transition:border-color .2s,background-color .2s}.dropzone.dragging{border-color:#171717;background:#fafafa}.upload-icon{width:43px;height:43px;display:grid;place-items:center;border-radius:50%;background:#171717;color:#fff;font-size:22px;margin-bottom:14px}.dropzone h2,.metadata-head h2,.clean-result h2{margin:0;font-size:20px;letter-spacing:-.55px}.dropzone p{font-size:14px;color:#777;margin:7px}.text-button{border:0;background:none;font:inherit;color:#171717;text-decoration:underline;cursor:pointer;padding:0}.dropzone .formats{font-size:12px;color:#999;margin-top:21px}.file-panel{padding:15px}.file-summary{display:flex;gap:12px;align-items:center;background:#fafafa;border:1px solid #eee;border-radius:8px;padding:10px}.file-type{width:36px;height:36px;display:grid;place-items:center;background:#ebf4ff;color:#0761d1;border-radius:5px;font:10px ui-monospace,monospace}.file-summary strong,.file-summary span{display:block;font-size:13px;overflow-wrap:anywhere}.file-summary span{color:#888;font-size:12px;margin-top:2px}.icon-button{margin-left:auto;border:0;background:transparent;font-size:23px;color:#777;cursor:pointer}.scan-results{padding:27px 3px 2px}.metadata-head{display:flex;justify-content:space-between;align-items:start}.label{font:11px ui-monospace,monospace;letter-spacing:.07em;color:#777;margin:0 0 7px}.metadata-head h2 span{color:#dd3a25}.scan-chip{font-size:11px;color:#008b5b;border:1px solid #bde4d5;background:#f4fffa;border-radius:20px;padding:5px 8px}.meta-list{margin:17px 0 18px;border-top:1px solid #eee}.meta-item{padding:11px 2px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center}.meta-item strong,.meta-item span{display:block;font-size:13px}.meta-item span{color:#777;font-size:12px;margin-top:2px}.meta-item small{font-size:11px;color:#777;background:#f4f4f4;border-radius:12px;padding:4px 7px}.primary-button{border:0;background:#171717;color:#fff;border-radius:999px;font-weight:550;font-size:14px;padding:13px 18px;width:100%;cursor:pointer;transition:transform .15s}.primary-button:hover{transform:translateY(-1px)}.primary-button span{float:right;font-size:17px;line-height:13px}.clean-result{text-align:center;padding:36px 14px 8px}.success-icon{margin:auto auto 15px;width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:#ddf8ee;color:#078558;font-size:23px}.clean-result h2{font-size:23px}.clean-result>p:not(.label){color:#666;font-size:14px;margin:9px auto 25px}.comparison{display:flex;align-items:center;justify-content:center;gap:25px;border:1px solid #eee;background:#fafafa;border-radius:8px;padding:13px;margin-bottom:17px}.comparison div{display:grid;gap:3px;text-align:left}.comparison span{font-size:11px;color:#777}.comparison strong{font-size:13px;font-variant-numeric:tabular-nums}.comparison .arrow{display:block;color:#999}.comparison .after strong{color:#09865b}.again-button{font-size:13px;border:0;background:none;color:#666;margin:16px 0 5px;cursor:pointer}.trust-row{margin:19px auto 0;display:flex;justify-content:center;gap:20px;font-size:12px;color:#777}.steps{max-width:1080px;margin:auto;padding:132px 28px 120px}.steps>.eyebrow,.formats>.eyebrow{justify-content:flex-start}.steps h2,.formats h2,.privacy-band h2{font-size:42px;letter-spacing:-.055em;line-height:1.05;margin:0 0 55px;text-wrap:balance}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #e7e7e7}.step-grid article{padding:27px 30px 0 0;border-right:1px solid #e7e7e7;min-height:230px}.step-grid article+article{padding-left:30px}.step-grid article:last-child{border-right:0}.step-grid b{font:12px ui-monospace,monospace;color:#999}.step-icon{font-size:25px;margin:31px 0 15px}.step-grid h3{font-size:18px;margin:0 0 8px;letter-spacing:-.4px}.step-grid p{font-size:14px;line-height:1.55;color:#666;max-width:260px;margin:0}.privacy-band{background:#171717;color:#fff;padding:110px max(28px,calc((100% - 1024px)/2));position:relative;min-height:430px;overflow:hidden}.privacy-band .eyebrow{justify-content:flex-start;color:#aaa}.privacy-band .eyebrow span{background:#fff}.privacy-band h2{max-width:520px;margin-bottom:0;font-size:43px}.privacy-band>p{max-width:470px;line-height:1.6;color:#b6b6b6;font-size:15px;margin-top:29px}.privacy-art{position:absolute;right:14%;top:50%;width:260px;height:260px;transform:translateY(-50%)}.orb{position:absolute;inset:55px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#f4f0ff,#a460ff 50%,#4726ab);box-shadow:0 0 90px #7f43ff70}.orbit{position:absolute;border:1px solid #8a75c8;border-radius:50%}.orbit.a{inset:15px;transform:rotate(-27deg) scaleY(.45)}.orbit.b{inset:0;transform:rotate(54deg) scaleY(.45)}.lock{position:absolute;inset:0;display:grid;place-items:center;font-size:43px;color:#fff;z-index:2}.formats{max-width:1080px;padding:120px 28px;margin:auto}.formats h2{margin-bottom:47px}.format-grid{display:grid;grid-template-columns:repeat(6,1fr);border:1px solid #e7e7e7;border-right:0}.format-grid div{min-height:115px;border-right:1px solid #e7e7e7;display:flex;justify-content:center;align-items:center;flex-direction:column;gap:9px}.format-grid strong{font:13px ui-monospace,monospace;color:#444}.format-grid span{font-size:12px;color:#777}footer{max-width:1200px;border-top:1px solid #eee;margin:auto;padding:29px 28px 35px;display:flex;align-items:center;gap:22px;color:#777;font-size:12px}footer p{margin:0}footer>span{margin-left:auto}:is(a,button,[role="button"]):focus-visible{outline:2px solid #0070f3;outline-offset:3px}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.dropzone,.primary-button{transition:none}}@media(max-width:700px){.nav-links{display:none}.nav{padding:0 18px}.hero{padding:18px 17px 45px}.hero h1{font-size:47px}.hero-copy{font-size:16px}.local-note{display:none}.trust-row{gap:8px;flex-wrap:wrap;padding:0 18px}.steps,.formats{padding:80px 24px}.steps h2,.formats h2,.privacy-band h2{font-size:35px}.step-grid{grid-template-columns:1fr}.step-grid article,.step-grid article+article{padding:24px 0;border-right:0;border-bottom:1px solid #e7e7e7;min-height:auto}.privacy-band{padding:75px 24px;min-height:500px}.privacy-art{right:-32px;bottom:-48px;top:auto;transform:none;opacity:.65}.format-grid{grid-template-columns:repeat(3,1fr)}.format-grid div{border-bottom:1px solid #e7e7e7}footer{flex-wrap:wrap}.meta-item{gap:7px}.comparison{gap:13px}}

/* The glow is an absolute background layer — it must never take up document space. */
.hero { padding-top: 12px; background: #fff; }
.hero > .hero-glow { position: absolute; top: -42px; opacity: .8; }
@media (max-width: 700px) { .hero { padding-top: 12px; } .hero > .hero-glow { top: -64px; } }
</style>
