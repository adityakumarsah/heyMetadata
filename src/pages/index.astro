---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MetaClean — Remove image and PDF metadata">
	<main>
		<nav class="nav" aria-label="Primary navigation">
			<a class="brand" href="/" aria-label="MetaClean home"><span class="brand-mark">✦</span> MetaClean</a>
			<div class="nav-links"><a href="#how-it-works">How it works</a><a href="#formats">Supported files</a><a href="#privacy">Privacy</a></div>
			<a class="nav-cta" href="#cleaner">Clean a file <span>↗</span></a>
		</nav>

		<section class="hero" id="cleaner">
			<div class="hero-glow" aria-hidden="true"></div>
			<p class="eyebrow"><span></span> PRIVATE BY DEFAULT</p>
			<h1>Remove metadata.<br /><em>Keep what matters.</em></h1>
			<p class="hero-copy">Inspect private metadata in your images and PDFs, then create a clean copy in your browser. Your file never leaves your device.</p>

			<div class="cleaner" id="cleaner-card">
				<div class="cleaner-top"><span class="status-dot"></span><span id="scanner-status">Ready to scan</span><span class="local-note">Processed locally in your browser</span></div>
				<div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Upload a file">
					<input id="file-input" name="file" type="file" hidden accept="application/pdf,image/jpeg,image/png,image/webp,image/tiff,image/heic,.pdf,.jpg,.jpeg,.png,.webp,.tif,.tiff,.heic" aria-label="Choose a file to inspect" />
					<div class="upload-icon">↑</div>
					<h2>Drop a file to inspect it</h2>
					<p>or <button class="text-button" id="browse-button">browse your device</button></p>
					<p class="formats">JPG, PNG, WebP, TIFF, HEIC, PDF · up to 25 MB · processed in your browser</p>
				</div>
				<div class="file-panel" id="file-panel" hidden>
					<div class="file-summary"><div class="file-type" id="file-type">JPG</div><div><strong id="file-name">photo.jpg</strong><span id="file-size">2.4 MB</span></div><button class="icon-button" id="reset-button" aria-label="Remove selected file">×</button></div>
					<div class="scan-results" id="scan-results">
						<div class="metadata-head"><div><p class="label">DOCUMENT INFORMATION</p><h2><span id="metadata-count">0</span> metadata fields found</h2></div><span class="scan-chip">Scanned locally</span></div>
						<div class="meta-list" id="meta-list"></div>
						<button class="primary-button" id="clean-button">Remove metadata <span>→</span></button>
					</div>
					<div class="clean-result" id="clean-result" hidden>
						<div class="success-icon">✓</div><p class="label">CLEAN COMPLETE</p><h2>Your clean file is ready.</h2><p id="result-copy">The generated file was checked and contains no removable metadata.</p>
						<div class="comparison"><div><span>Before</span><strong id="before-count">0 fields</strong></div><div class="arrow">→</div><div class="after"><span>After</span><strong id="after-count">0 fields</strong></div></div>
						<button class="primary-button" id="download-button">Download clean file <span>↓</span></button><button class="again-button" id="again-button">Clean another file</button>
					</div>
				</div>
			</div>
			<div class="trust-row"><span>✓ No upload required</span><span>✓ Processed only in this browser tab</span><span>✓ New PDF generated locally</span></div>
		</section>

		<section class="steps" id="how-it-works"><p class="eyebrow"><span></span> HOW IT WORKS</p><h2>Your private cleanup crew.</h2><div class="step-grid"><article><b>01</b><h3>Inspect</h3><p>We read available EXIF, IPTC, XMP, GPS, camera, and document-information fields.</p></article><article><b>02</b><h3>Clean</h3><p>We create a fresh image or PDF locally without the original metadata containers.</p></article><article><b>03</b><h3>Verify</h3><p>We inspect the generated file again before making it available for download.</p></article></div></section>

		<section class="privacy-band" id="privacy"><div><p class="eyebrow"><span></span> YOUR FILES, YOUR DEVICE</p><h2>Privacy that doesn’t need a pinky promise.</h2></div><p>MetaClean runs in your browser. We never need to see, store, or process your files on a server. Close this tab and everything is gone.</p><div class="privacy-art" aria-hidden="true"><div class="orb"></div><div class="orbit a"></div><div class="orbit b"></div><div class="lock">⌑</div></div></section>

		<section class="formats" id="formats"><p class="eyebrow"><span></span> SUPPORTED FORMATS</p><h2>Images and PDF documents.</h2><div class="format-grid"><div><strong>JPG</strong><span>Photos</span></div><div><strong>PNG</strong><span>Images</span></div><div><strong>WEBP</strong><span>Images</span></div><div><strong>TIFF</strong><span>Images</span></div><div><strong>HEIC</strong><span>Images</span></div><div><strong>PDF</strong><span>Documents</span></div></div></section>
		<footer><a class="brand" href="/"><span class="brand-mark">✦</span> MetaClean</a><p>Less data. More you.</p><span>© 2026 MetaClean</span></footer>
	</main>

	<script>
		import { PDFDocument } from 'pdf-lib';
		import ExifReader from 'exifreader';
		import { heicTo } from 'heic-to';
		import * as UTIF from 'utif';

		const input = document.querySelector('#file-input'); const dropzone = document.querySelector('#dropzone'); const browse = document.querySelector('#browse-button'); const panel = document.querySelector('#file-panel'); const results = document.querySelector('#scan-results'); const result = document.querySelector('#clean-result'); const metaList = document.querySelector('#meta-list'); const status = document.querySelector('#scanner-status'); const cleanButton = document.querySelector('#clean-button');
		let selectedFile; let cleanedBytes; let cleanedType; let selectedKind; let metadata = [];
		const fields = [['Title', 'getTitle'], ['Author', 'getAuthor'], ['Subject', 'getSubject'], ['Keywords', 'getKeywords'], ['Creator', 'getCreator'], ['Producer', 'getProducer'], ['Creation date', 'getCreationDate'], ['Modification date', 'getModificationDate']];
		const formats = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', tif: 'image/tiff', tiff: 'image/tiff', heic: 'image/heic', heif: 'image/heic', pdf: 'application/pdf' };
		function formatSize(bytes) { return bytes < 1024 * 1024 ? `${Math.ceil(bytes / 1024)} KB` : `${(bytes / 1024 / 1024).toFixed(1)} MB`; }
		function extension(file) { return (file.name.split('.').pop() || '').toLowerCase(); }
		function fileKind(file) { return file.type === 'application/pdf' || extension(file) === 'pdf' ? 'pdf' : formats[extension(file)] ? 'image' : undefined; }
		function valueFor(pdf, method) { try { const value = pdf[method](); return value instanceof Date ? value.toLocaleString() : value; } catch { return undefined; } }
		function extractPdfMetadata(pdf) { return fields.map(([name, method]) => [name, valueFor(pdf, method), 'Document info']).filter(([, value]) => value !== undefined && value !== ''); }
		function displayValue(value) { if (value instanceof Date) return value.toLocaleString(); if (Array.isArray(value)) return value.map(displayValue).join(', '); if (value instanceof Uint8Array) return `${value.byteLength} bytes`; if (value && typeof value === 'object') return JSON.stringify(value); return String(value); }
		const metadataGroups = { exif: 'EXIF', gps: 'GPS', iptc: 'IPTC', xmp: 'XMP', makerNotes: 'Camera notes', photoshop: 'Photoshop', pngText: 'PNG text' };
		const imageStructureTags = new Set(['ImageWidth', 'ImageLength', 'BitsPerSample', 'Compression', 'PhotometricInterpretation', 'StripOffsets', 'SamplesPerPixel', 'RowsPerStrip', 'StripByteCounts', 'PlanarConfiguration', 'TileWidth', 'TileLength', 'TileOffsets', 'TileByteCounts', 'Predictor', 'ExtraSamples', 'SampleFormat', 'XResolution', 'YResolution', 'XPosition', 'YPosition', 'ResolutionUnit', 'Software']);
		async function extractImageMetadata(file) { const parsed = await ExifReader.load(file, { expanded: true, includeUnknown: true }); return Object.entries(parsed || {}).filter(([group]) => metadataGroups[group]).flatMap(([group, value]) => Object.entries(value || {}).filter(([name]) => group !== 'exif' || !imageStructureTags.has(name)).map(([name, tag]) => [name, displayValue(tag.description ?? tag.value ?? tag), metadataGroups[group]])); }
		function renderMetadata() { metaList.replaceChildren(); metadata.forEach(([name, value, group]) => { const item = document.createElement('div'); item.className = 'meta-item'; const content = document.createElement('div'); const label = document.createElement('strong'); const detail = document.createElement('span'); const category = document.createElement('small'); label.textContent = name; detail.textContent = value; category.textContent = group; content.append(label, detail); item.append(content, category); metaList.append(item); }); if (!metadata.length) { const item = document.createElement('div'); item.className = 'meta-item'; item.textContent = 'No removable metadata was found in this file.'; metaList.append(item); } }
		function setFileDetails(file, type) { document.querySelector('#file-name').textContent = file.name; document.querySelector('#file-size').textContent = formatSize(file.size); document.querySelector('#file-type').textContent = type; document.querySelector('#metadata-count').textContent = metadata.length; document.querySelector('#before-count').textContent = `${metadata.length} field${metadata.length === 1 ? '' : 's'}`; renderMetadata(); dropzone.hidden = true; panel.hidden = false; results.hidden = false; result.hidden = true; }
		async function handleFile(file) { if (!file) return; if (file.size > 25 * 1024 * 1024) { status.textContent = 'Files must be 25 MB or smaller'; return; } selectedKind = fileKind(file); if (!selectedKind) { status.textContent = 'Choose a JPG, PNG, WebP, TIFF, HEIC, or PDF file'; return; } try { status.textContent = 'Inspecting metadata locally…'; const parsed = selectedKind === 'pdf' ? extractPdfMetadata(await PDFDocument.load(await file.arrayBuffer(), { updateMetadata: false })) : await extractImageMetadata(file); selectedFile = file; cleanedBytes = undefined; metadata = parsed; setFileDetails(file, selectedKind === 'pdf' ? 'PDF' : extension(file).toUpperCase()); status.textContent = 'Scan complete'; } catch { selectedFile = undefined; status.textContent = selectedKind === 'pdf' ? 'Unable to read this PDF. Password-protected PDFs are not supported.' : 'Unable to read metadata from this image.'; } }
		async function cleanPdf() { const source = await PDFDocument.load(await selectedFile.arrayBuffer(), { updateMetadata: false }); const clean = await PDFDocument.create({ updateMetadata: false }); const pages = await clean.copyPages(source, source.getPageIndices()); pages.forEach((page) => clean.addPage(page)); return { bytes: await clean.save({ updateFieldAppearances: false, useObjectStreams: true }), type: 'application/pdf' }; }
		async function imageBitmapFor(file) { const type = formats[extension(file)]; if (type === 'image/heic') return heicTo({ blob: file, type: 'bitmap' }); if (type === 'image/tiff') { const bytes = await file.arrayBuffer(); const ifd = UTIF.decode(bytes)[0]; UTIF.decodeImage(bytes, ifd); const rgba = UTIF.toRGBA8(ifd); return createImageBitmap(new ImageData(new Uint8ClampedArray(rgba.buffer, rgba.byteOffset, rgba.byteLength), ifd.width, ifd.height)); } return createImageBitmap(file, { imageOrientation: 'from-image' }); }
		function canvasBlob(canvas, type, quality) { return new Promise((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Image encoder is unavailable')), type, quality)); }
		function joinBytes(chunks) { const length = chunks.reduce((total, chunk) => total + chunk.length, 0); const output = new Uint8Array(length); let offset = 0; chunks.forEach((chunk) => { output.set(chunk, offset); offset += chunk.length; }); return output; }
		function stripJpegMetadata(source) { const bytes = new Uint8Array(source); if (bytes[0] !== 0xff || bytes[1] !== 0xd8) return bytes; const chunks = [bytes.slice(0, 2)]; let offset = 2; while (offset < bytes.length) { const start = offset; if (bytes[offset++] !== 0xff) return joinBytes([...chunks, bytes.slice(start)]); while (bytes[offset] === 0xff) offset += 1; const marker = bytes[offset++]; if (marker === 0xda || marker === 0xd9) return joinBytes([...chunks, bytes.slice(start)]); if (marker >= 0xd0 && marker <= 0xd7) { chunks.push(bytes.slice(start, offset)); continue; } const size = (bytes[offset] << 8) | bytes[offset + 1]; if (size < 2 || offset + size > bytes.length) return bytes; if (![0xe1, 0xe2, 0xed, 0xfe].includes(marker)) chunks.push(bytes.slice(start, offset + size)); offset += size; } return joinBytes(chunks); }
		function stripChunkMetadata(source, type) { const bytes = new Uint8Array(source); const png = type === 'image/png'; const webp = type === 'image/webp'; if ((!png || String.fromCharCode(...bytes.slice(1, 4)) !== 'PNG') && (!webp || String.fromCharCode(...bytes.slice(0, 4)) !== 'RIFF')) return bytes; const chunks = [bytes.slice(0, png ? 8 : 12)]; let offset = png ? 8 : 12; while (offset + 8 <= bytes.length) { const sizeOffset = png ? offset : offset + 4; const nameOffset = png ? offset + 4 : offset; const size = new DataView(bytes.buffer, bytes.byteOffset + sizeOffset).getUint32(0, !png); const name = String.fromCharCode(...bytes.slice(nameOffset, nameOffset + 4)); const end = offset + 8 + size + (png ? 4 : size % 2); if (end > bytes.length) return bytes; if (!(png ? ['eXIf', 'iCCP', 'tEXt', 'zTXt', 'iTXt'].includes(name) : ['EXIF', 'ICCP', 'XMP '].includes(name))) chunks.push(bytes.slice(offset, end)); offset = end; } const output = joinBytes(chunks); if (webp) new DataView(output.buffer).setUint32(4, output.length - 8, true); return output; }
		function stripGeneratedMetadata(bytes, type) { return type === 'image/jpeg' ? stripJpegMetadata(bytes) : type === 'image/png' || type === 'image/webp' ? stripChunkMetadata(bytes, type) : bytes; }
		async function cleanImage() { const sourceType = formats[extension(selectedFile)]; if (sourceType === 'image/tiff') { const source = await selectedFile.arrayBuffer(); const ifd = UTIF.decode(source)[0]; UTIF.decodeImage(source, ifd); const rgba = UTIF.toRGBA8(ifd); return { bytes: new Uint8Array(UTIF.encodeImage(rgba.buffer.slice(rgba.byteOffset, rgba.byteOffset + rgba.byteLength), ifd.width, ifd.height, { t305: [] })), type: 'image/tiff' }; } if (sourceType === 'image/heic') { const blob = await heicTo({ blob: selectedFile, type: 'image/jpeg', quality: 1 }); return { bytes: stripJpegMetadata(await blob.arrayBuffer()), type: 'image/jpeg' }; } const bitmap = await imageBitmapFor(selectedFile); try { const canvas = document.createElement('canvas'); canvas.width = bitmap.width; canvas.height = bitmap.height; canvas.getContext('2d', { alpha: true }).drawImage(bitmap, 0, 0); const blob = await canvasBlob(canvas, sourceType, sourceType === 'image/png' ? undefined : 1); return { bytes: stripGeneratedMetadata(await blob.arrayBuffer(), sourceType), type: sourceType }; } finally { bitmap.close?.(); } }
		function outputExtension(type) { return type === 'application/pdf' ? 'pdf' : type === 'image/png' ? 'png' : type === 'image/webp' ? 'webp' : type === 'image/tiff' ? 'tiff' : 'jpg'; }
		async function verifyCleanFile(bytes, type) { if (type === 'application/pdf') return extractPdfMetadata(await PDFDocument.load(bytes, { updateMetadata: false })); return extractImageMetadata(new File([bytes], `clean.${outputExtension(type)}`, { type })); }
		async function cleanFile() { if (!selectedFile) return; try { cleanButton.disabled = true; cleanButton.textContent = 'Creating clean file…'; status.textContent = 'Removing metadata locally…'; const cleaned = selectedKind === 'pdf' ? await cleanPdf() : await cleanImage(); cleanedBytes = cleaned.bytes; cleanedType = cleaned.type; const remaining = await verifyCleanFile(cleaned.bytes, cleaned.type); document.querySelector('#after-count').textContent = `${remaining.length} field${remaining.length === 1 ? '' : 's'}`; const converted = selectedKind === 'image' && formats[extension(selectedFile)] !== cleaned.type; document.querySelector('#result-copy').textContent = remaining.length === 0 ? `Removed ${metadata.length} metadata field${metadata.length === 1 ? '' : 's'}. The generated ${selectedKind === 'pdf' ? 'PDF' : 'image'} was checked again and has none remaining.${converted ? ' HEIC files are exported as JPG because browsers cannot encode HEIC.' : ''}` : `A clean file was generated, but ${remaining.length} metadata field${remaining.length === 1 ? '' : 's'} remain.`; results.hidden = true; result.hidden = false; status.textContent = remaining.length === 0 ? 'Metadata removed and verified' : 'Metadata cleanup needs review'; } catch { status.textContent = 'Unable to create a clean file'; } finally { cleanButton.disabled = false; cleanButton.innerHTML = 'Remove metadata <span>→</span>'; } }
		browse.addEventListener('click', () => input.click()); input.addEventListener('change', (event) => handleFile(event.target.files[0])); dropzone.addEventListener('dragover', (event) => { event.preventDefault(); dropzone.classList.add('dragging'); }); dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragging')); dropzone.addEventListener('drop', (event) => { event.preventDefault(); dropzone.classList.remove('dragging'); handleFile(event.dataTransfer.files[0]); }); dropzone.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') input.click(); });
		cleanButton.addEventListener('click', cleanFile); document.querySelector('#download-button').addEventListener('click', () => { if (!cleanedBytes) return; const url = URL.createObjectURL(new Blob([cleanedBytes], { type: cleanedType })); const link = document.createElement('a'); link.href = url; link.download = selectedFile.name.replace(/\.[^.]+$/, `-clean.${outputExtension(cleanedType)}`); link.click(); setTimeout(() => URL.revokeObjectURL(url), 0); });
		function reset() { input.value = ''; selectedFile = undefined; cleanedBytes = undefined; cleanedType = undefined; metadata = []; panel.hidden = true; dropzone.hidden = false; status.textContent = 'Ready to scan'; } document.querySelector('#reset-button').addEventListener('click', reset); document.querySelector('#again-button').addEventListener('click', reset);
	</script>
</Layout>

<style>
 :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#171717;background:#fff}main{overflow:hidden}.nav{height:64px;max-width:1200px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:650;letter-spacing:-.8px;color:#171717;text-decoration:none;font-size:18px;display:flex;align-items:center;gap:8px}.brand-mark{font-size:20px}.nav-links{display:flex;gap:26px}.nav-links a{font-size:14px;color:#666;text-decoration:none}.nav-cta{font-size:14px;background:#171717;color:#fff;text-decoration:none;padding:9px 13px;border-radius:6px}.nav-cta span{margin-left:7px}.hero{position:relative;text-align:center;padding:18px 24px 61px;border-top:1px solid #f1f1f1;background:radial-gradient(ellipse 44% 20% at 50% 18%,#e7efff 0%,rgba(243,247,255,.6) 35%,transparent 72%)}.hero-glow{position:absolute;width:650px;height:320px;left:50%;top:-45px;transform:translateX(-50%);background:radial-gradient(circle at 25% 50%,#b8f4ea80,transparent 35%),radial-gradient(circle at 70% 45%,#e3c7ff90,transparent 36%),radial-gradient(circle at 50% 80%,#aed5ff70,transparent 38%);filter:blur(24px);pointer-events:none}.hero>*{position:relative}.eyebrow{font:12px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.07em;color:#666;margin:0 0 20px;display:flex;justify-content:center;align-items:center;gap:8px}.eyebrow span{width:7px;height:7px;background:#111;border-radius:50%}.hero h1{font-size:clamp(45px,6vw,76px);letter-spacing:-.075em;line-height:.97;font-weight:620;margin:0;text-wrap:balance}.hero h1 em{font-style:normal;background:linear-gradient(90deg,#007cf0,#7928ca 48%,#ff0080);background-clip:text;-webkit-background-clip:text;color:transparent}.hero-copy{max-width:500px;margin:24px auto 37px;font-size:17px;line-height:1.55;color:#666}.cleaner{width:min(100%,650px);margin:0 auto;background:#fff;text-align:le