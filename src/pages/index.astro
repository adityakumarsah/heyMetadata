		let selectedFile, cleanedBytes, cleanedType, selectedKind;
		let metadata = [];
		let videoCleanedUrl = null; // Blob URL for video (avoids storing 250 MB in JS state)

		// ── MIME / extension helpers ──────────────────────────────────────────────
		const imageFormats = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', tif: 'image/tiff', tiff: 'image/tiff', heic: 'image/heic', heif: 'image/heic' };
		const audioFormats = { mp3: 'audio/mpeg', wav: 'audio/wav', m4a: 'audio/mp4', flac: 'audio/flac', ogg: 'audio/ogg' };
		const audioMimeToExt = { 'audio/mpeg': 'mp3', 'audio/wav': 'wav', 'audio/mp4': 'm4a', 'audio/flac': 'flac', 'audio/ogg': 'ogg' };
		const videoFormats = { mp4: 'video/mp4', mov: 'video/quicktime', mkv: 'video/x-matroska', avi: 'video/x-msvideo', webm: 'video/webm' };
		const videoMimeToExt = { 'video/mp4': 'mp4', 'video/quicktime': 'mov', 'video/x-matroska': 'mkv', 'video/x-msvideo': 'avi', 'video/webm': 'webm' };
		const imageMimeToExt = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/tiff': 'tiff', 'image/heic': 'heic' };
		const officeExts = { docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', pptx: 'application/vnd.openxmlformats-officedocument.presentationml.presentation' };
		function formatSize(b) { return b < 1048576 ? `${Math.ceil(b / 1024)} KB` : `${(b / 1048576).toFixed(1)} MB`; }
		function extension(file) { return (file.name.split('.').pop() || '').toLowerCase(); }
		function fileKind(file) {
			const ext = extension(file);
			if (file.type === 'application/pdf' || ext === 'pdf') return 'pdf';
			if (officeExts[ext]) return 'office';
			if (imageFormats[ext]) return 'image';
			if (audioFormats[ext]) return 'audio';
			if (audioMimeToExt[file.type]) return 'audio';
			if (videoFormats[ext]) return 'video';
			if (videoMimeToExt[file.type]) return 'video';
			return undefined;
		}
		function outputExtension(type) {
			if (type === 'application/pdf') return 'pdf';
			if (type === 'image/png') return 'png';
			if (type === 'image/webp') return 'webp';
			if (type === 'image/tiff') return 'tiff';
			if (officeExts[extension({ name: '.' + type.split('.').pop() })]) return type.split('.').pop();
			const officeExt = Object.entries(officeExts).find(([, mime]) => mime === type);
			if (officeExt) return officeExt[0];
			return 'jpg';
		}
		function mimeForOffice(file) { return officeExts[extension(file)] || file.type; }

		// ── PDF metadata ─────────────────────────────────────────────────────────
		const pdfFields = [['Title','getTitle'],['Author','getAuthor'],['Subject','getSubject'],['Keywords','getKeywords'],['Creator','getCreator'],['Producer','getProducer'],['Creation date','getCreationDate'],['Modification date','getModificationDate']];
		function valueFor(pdf, method) { try { const v = pdf[method](); return v instanceof Date ? v.toLocaleString() : v; } catch { return undefined; } }
		function extractPdfMetadata(pdf) { return pdfFields.map(([n, m]) => [n, valueFor(pdf, m), 'Document info']).filter(([, v]) => v !== undefined && v !== ''); }

		// ── Image metadata ────────────────────────────────────────────────────────
		function displayValue(v) {
			if (v === null || v === undefined) return '';
			if (v instanceof Date) return v.toLocaleString();
			if (Array.isArray(v)) return v.map(displayValue).filter(Boolean).join(', ');
			if (v instanceof Uint8Array) return `${v.byteLength} bytes`;
			if (v && typeof v === 'object') return v.description ?? (typeof v.value === 'object' ? JSON.stringify(v.value) : v.value) ?? JSON.stringify(v);
			return String(v);
		}
		const imageStructureTags = new Set([
			'ImageWidth', 'ImageLength', 'BitsPerSample', 'Compression',
			'PhotometricInterpretation', 'StripOffsets', 'SamplesPerPixel',
			'RowsPerStrip', 'StripByteCounts', 'PlanarConfiguration',
			'TileWidth', 'TileLength', 'TileOffsets', 'TileByteCounts',
			'Predictor', 'ExtraSamples', 'SampleFormat', 'XResolution',
			'YResolution', 'XPosition', 'YPosition', 'ResolutionUnit',
			'JPEGInterchangeFormat', 'JPEGInterchangeFormatLength',
			'Exif IFD Pointer', 'GPS Info IFD Pointer', 'Interoperability IFD Pointer',
			'Thumbnail'
		]);
		const pngStructureTags = new Set([
			'Image Width', 'Image Height', 'Bit Depth', 'Color Type',
			'Compression', 'Filter', 'Interlace', 'Pixel Units',
			'Pixels Per Unit X', 'Pixels Per Unit Y'
		]);
		function detectBinaryIcc(bytes) {
			const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
			// JPEG APP2 ICC_PROFILE
			if (u8[0] === 0xff && u8[1] === 0xd8) {
				let off = 2;
				while (off + 4 < u8.length) {
					if (u8[off] !== 0xff) { off++; continue; }
					while (u8[off] === 0xff) off++;
					const marker = u8[off++];
					if (marker === 0xda || marker === 0xd9) break;
					const len = (u8[off] << 8) | u8[off + 1];
					if (len < 2 || off + len > u8.length) break;
					if (marker === 0xe2 && len >= 14) {
						const sig = String.fromCharCode(...u8.slice(off + 2, off + 14));
						if (sig === 'ICC_PROFILE\0') return true;
					}
					off += len;
				}
			}
			// PNG iCCP chunk
			if (u8[0] === 0x89 && u8[1] === 0x50 && u8[2] === 0x4e && u8[3] === 0x47) {
				let off = 8;
				while (off + 8 <= u8.length) {
					const len = new DataView(u8.buffer, u8.byteOffset + off).getUint32(0, false);
					const name = String.fromCharCode(...u8.slice(off + 4, off + 8));
					if (name === 'iCCP') return true;
					off += 8 + len + 4;
				}
			}
			// WebP ICCP chunk
			if (u8[0] === 0x52 && u8[1] === 0x49 && u8[2] === 0x46 && u8[3] === 0x46) {
				let off = 12;
				while (off + 8 <= u8.length) {
					const len = new DataView(u8.buffer, u8.byteOffset + off + 4).getUint32(0, true);
					const name = String.fromCharCode(...u8.slice(off, off + 4));
					if (name === 'ICCP') return true;
					off += 8 + len + (len % 2);
				}
			}
			return false;
		}
		async function extractImageMetadata(file) {
			let parsed;
			try {
				parsed = await ExifReader.load(file, { expanded: true, includeUnknown: true, async: true });
			} catch (err) {
				if (!err || (err.name !== 'MetadataMissingError' && !err.message?.includes('No metadata'))) {
					throw err;
				}
			}

			const rows = [];

			if (parsed) {
				// 1. Standard metadata groups
				const groupLabels = {
					exif: 'EXIF',
					iptc: 'IPTC',
					xmp: 'XMP',
					makerNotes: 'Camera notes',
					photoshop: 'Photoshop',
					pngText: 'PNG text'
				};

				for (const [groupKey, defaultLabel] of Object.entries(groupLabels)) {
					const groupObj = parsed[groupKey];
					if (groupObj && typeof groupObj === 'object') {
						for (const [tagName, tag] of Object.entries(groupObj)) {
							if (groupKey === 'exif' && imageStructureTags.has(tagName)) continue;
							if (groupKey === 'xmp' && tagName === '_raw') continue;
							const val = displayValue(tag.description ?? tag.value ?? tag);
							if (val !== undefined && val !== '') {
								const label = (groupKey === 'exif' && tagName.startsWith('GPS')) ? 'GPS' : defaultLabel;
								rows.push([tagName, val, label]);
							}
						}
					}
				}

				// 2. PNG non-text metadata (e.g. Modify Date from tIME chunk)
				if (parsed.png && typeof parsed.png === 'object') {
					for (const [tagName, tag] of Object.entries(parsed.png)) {
						if (pngStructureTags.has(tagName)) continue;
						if (parsed.pngText && tagName in parsed.pngText) continue;
						const val = displayValue(tag.description ?? tag.value ?? tag);
						if (val !== undefined && val !== '') {
							rows.push([tagName, val, 'PNG']);
						}
					}
				}

				// 3. ICC Color Profile (represented as a single meaningful entry)
				if (parsed.icc && typeof parsed.icc === 'object' && Object.keys(parsed.icc).length > 0) {
					const desc = parsed.icc['ICC Description']?.description ||
					             parsed.icc['ICC Description']?.value ||
					             parsed.icc['Profile Description']?.description ||
					             parsed.icc['Profile Description']?.value ||
					             (parsed.icc['Color Space'] ? `Present (${parsed.icc['Color Space'].description?.trim() || parsed.icc['Color Space'].value})` : 'Present');
					rows.push(['Color Profile', typeof desc === 'string' ? desc : 'Present', 'Color profile']);
				}

				// 4. Thumbnail (represented as a single meaningful entry)
				if (parsed.Thumbnail || (parsed.thumbnail && Object.keys(parsed.thumbnail).length > 0)) {
					rows.push(['Thumbnail', 'Present', 'Thumbnail']);
				}
			}

			// 5. Fallback binary ICC detection if not already captured
			const hasIcc = rows.some(r => r[0] === 'Color Profile');
			if (!hasIcc) {
				try {
					let buf;
					if (file instanceof ArrayBuffer) buf = file;
					else if (file instanceof Uint8Array) buf = file;
					else if (file && typeof file.arrayBuffer === 'function') buf = await file.arrayBuffer();
					if (buf && detectBinaryIcc(buf)) {
						rows.push(['Color Profile', 'Present', 'Color profile']);
					}
				} catch {}
			}

			return rows;
		}

		// ── Office Open XML (DOCX / XLSX / PPTX) metadata ────────────────────────
		//
		// OOXML files are ZIP archives. Metadata lives in three XML parts:
		//   docProps/core.xml    – Dublin Core / OPC core properties
		//   docProps/app.xml     – Application-specific extended properties
		//   docProps/custom.xml  – User-defined custom document properties

		/** Parse an XML string with DOMParser and return the document. */
		function parseXml(str) {
			return new DOMParser().parseFromString(str, 'application/xml');
		}

		/**
		 * Pull text content from an element by local name, searching across all
		 * namespace prefixes (getElementsByTagNameNS('*', localName)).
		 */
		function xmlText(doc, localName) {
			const el = doc.getElementsByTagNameNS('*', localName)[0];
			return el ? el.textContent.trim() : null;
		}

		/**
		 * Extract human-readable metadata fields from docProps/core.xml.
		 * Returns an array of [fieldName, value, group] triples.
		 */
		function extractCoreProps(xmlStr) {
			if (!xmlStr) return [];
			const doc = parseXml(xmlStr);
			const fields = [
				['Title',           'title'],
				['Subject',         'subject'],
				['Author',          'creator'],
				['Keywords',        'keywords'],
				['Description',     'description'],
				['Last Modified By','lastModifiedBy'],
				['Revision',        'revision'],
				['Category',        'category'],
				['Content Status',  'contentStatus'],
				['Creation Date',   'created'],
				['Modified Date',   'modified'],
			];
			return fields
				.map(([label, localName]) => [label, xmlText(doc, localName), 'Core properties'])
				.filter(([, v]) => v !== null && v !== '');
		}

		/**
		 * Extract human-readable metadata fields from docProps/app.xml.
		 * Returns an array of [fieldName, value, group] triples.
		 */
		function extractAppProps(xmlStr) {
			if (!xmlStr) return [];
			const doc = parseXml(xmlStr);
			const fields = [
				['Application',      'Application'],
				['App Version',      'AppVersion'],
				['Company',          'Company'],
				['Manager',          'Manager'],
				['Template',         'Template'],
				['Total Edit Time',  'TotalTime'],
				['Presentation Format', 'PresentationFormat'],
				['Slide Count',      'Slides'],
				['Note Count',       'Notes'],
				['Hidden Slides',    'HiddenSlides'],
				['Sheet Count',      'Sheets'],
				['Word Count',       'Words'],
				['Character Count',  'Characters'],
				['Paragraph Count',  'Paragraphs'],
				['Line Count',       'Lines'],
				['Page Count',       'Pages'],
				['Document Security','DocSecurity'],
			];
			return fields
				.map(([label, localName]) => [label, xmlText(doc, localName), 'App properties'])
				.filter(([, v]) => v !== null && v !== '' && v !== '0');
		}

		/**
		 * Extract custom document properties from docProps/custom.xml.
		 * Each <property name="…"> element becomes one metadata row.
		 * The typed value child (vt:lpwstr, vt:i4, vt:bool, vt:date, …) is read
		 * as plain text regardless of type — sufficient for display.
		 */
		function extractCustomProps(xmlStr) {
			if (!xmlStr) return [];
			const doc = parseXml(xmlStr);
			// <property fmtid="…" pid="…" name="MyProp"><vt:lpwstr>value</vt:lpwstr></property>
			const props = Array.from(doc.getElementsByTagNameNS('*', 'property'));
			return props.flatMap((el) => {
				const name = el.getAttribute('name');
				if (!name) return [];
				// Value is the text content of the single typed-value child element
				const valueEl = el.firstElementChild;
				const value = valueEl ? valueEl.textContent.trim() : '';
				if (!value) return [];
				return [[name, value, 'Custom properties']];
			});
		}

		/**
		 * Read an OOXML ZIP from an ArrayBuffer and return extracted metadata.
		 */
		function extractOfficeMetadata(buffer) {
			const zip = unzipSync(new Uint8Array(buffer));
			const decode = (key) => zip[key] ? strFromU8(zip[key]) : null;
			return [
				...extractCoreProps(decode('docProps/core.xml')),
				...extractAppProps(decode('docProps/app.xml')),
				...extractCustomProps(decode('docProps/custom.xml')),
			];
		}

		/**
		 * Build a clean docProps/core.xml that has no personal metadata.
		 * We keep the XML declaration and root element but remove all property
		 * child elements that carry author / date / revision data.
		 */
		function buildCleanCoreXml() {
			return [
				'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>',
				'<cp:coreProperties',
				'  xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties"',
				'  xmlns:dc="http://purl.org/dc/elements/1.1/"',
				'  xmlns:dcterms="http://purl.org/dc/terms/"',
				'  xmlns:dcmitype="http://purl.org/dc/dcmitype/"',
				'  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">',
				'</cp:coreProperties>',
			].join('\n');
		}

		/**
		 * Build a clean docProps/app.xml that has no personal/company metadata.
		 * We preserve only the minimal structure (no Application, Company, Manager
		 * or TotalTime fields).
		 */
		function buildCleanAppXml() {
			return [
				'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>',
				'<Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties"',
				'            xmlns:vt="http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes">',
				'</Properties>',
			].join('\n');
		}

		/**
		 * Remove the custom-properties Relationship from _rels/.rels so that
		 * Office does not error when opening a file whose docProps/custom.xml
		 * has been deleted.
		 *
		 * Strategy: parse the XML with DOMParser, remove the matching
		 * <Relationship> element, and serialize back with XMLSerializer.
		 * We fall back to the original string if anything goes wrong.
		 */
		function removeCustomXmlFromRels(relsXmlStr) {
			if (!relsXmlStr) return relsXmlStr;
			try {
				const doc = parseXml(relsXmlStr);
				const CUSTOM_PROPS_TYPE =
					'http://schemas.openxmlformats.org/officeDocument/2006/relationships/custom-properties';
				const rels = Array.from(doc.getElementsByTagNameNS('*', 'Relationship'));
				let changed = false;
				for (const rel of rels) {
					if (rel.getAttribute('Type') === CUSTOM_PROPS_TYPE) {
						rel.parentNode.removeChild(rel);
						changed = true;
					}
				}
				if (!changed) return relsXmlStr;
				// Re-serialize; keep the XML declaration if the original had one
				const serialized = new XMLSerializer().serializeToString(doc);
				const decl = relsXmlStr.startsWith('<?xml') ? '' : '';
				return decl + serialized;
			} catch {
				return relsXmlStr; // safe fallback — leave rels untouched
			}
		}

		/**
		 * Remove personal metadata from an OOXML file.
		 * • Replaces docProps/core.xml and docProps/app.xml with clean versions.
		 * • Deletes docProps/custom.xml entirely (custom properties are fully
		 *   user-defined and carry no structural role inside the document).
		 * • Patches _rels/.rels to remove the dangling custom-properties
		 *   relationship reference so Office doesn't error on open.
		 * • Re-packs all remaining ZIP entries verbatim.
		 */
		async function cleanOfficeFile(file) {
			const buffer = await file.arrayBuffer();
			const zip = unzipSync(new Uint8Array(buffer));

			// 1. Overwrite core and app metadata with clean, empty versions.
			if (zip['docProps/core.xml']) {
				zip['docProps/core.xml'] = strToU8(buildCleanCoreXml());
			}
			if (zip['docProps/app.xml']) {
				zip['docProps/app.xml'] = strToU8(buildCleanAppXml());
			}

			// 2. Remove custom properties file entirely — it is safe to delete
			//    because it carries no content referenced by document body parts.
			const hasCustom = 'docProps/custom.xml' in zip;
			if (hasCustom) {
				delete zip['docProps/custom.xml'];
			}

			// 3. Patch _rels/.rels to remove the custom-properties Relationship.
			//    Leaving a <Relationship> pointing at a deleted part causes Word /
			//    Excel / PowerPoint to report the file as corrupt on open.
			const relsKey = '_rels/.rels';
			if (hasCustom && zip[relsKey]) {
				const patchedRels = removeCustomXmlFromRels(strFromU8(zip[relsKey]));
				zip[relsKey] = strToU8(patchedRels);
			}

			// 4. Re-pack everything that remains.
			const toZip = {};
			for (const [path, data] of Object.entries(zip)) {
				toZip[path] = [data, { level: 6 }];
			}

			const output = zipSync(toZip);
			const mime = mimeForOffice(file);
			return { bytes: output, type: mime };
		}

		// ── Verify clean office file ──────────────────────────────────────────────
		function verifyCleanOffice(buffer) {
			return extractOfficeMetadata(buffer.buffer ?? buffer);
		}

		// ── UI helpers ────────────────────────────────────────────────────────────
		function renderMetadata() {
			metaList.replaceChildren();
			metadata.forEach(([name, value, group]) => {
				// Album artwork gets a dedicated visual row rendered by renderAlbumArt
				if (name === 'Album artwork') return;
				const item = document.createElement('div');
				item.className = 'meta-item';
				const content = document.createElement('div');
				const label = document.createElement('strong');
				const detail = document.createElement('span');
				const category = document.createElement('small');
				label.textContent = name;
				detail.textContent = value;
				category.textContent = group;
				content.append(label, detail);
				item.append(content, category);
				metaList.append(item);
			});
			if (!metadata.length) {
				const item = document.createElement('div');
				item.className = 'meta-item';
				item.textContent = 'No removable metadata was found in this file.';
				metaList.append(item);
			}
		}

		function setFileDetails(file, typeLabel) {
			document.querySelector('#file-name').textContent = file.name;
			document.querySelector('#file-size').textContent = formatSize(file.size);
			document.querySelector('#file-type').textContent = typeLabel;
			document.querySelector('#metadata-count').textContent = metadata.length;
			document.querySelector('#before-count').textContent = `${metadata.length} field${metadata.length === 1 ? '' : 's'}`;
			renderMetadata();
			// For audio: render embedded album art thumbnail if present
			if (selectedKind === 'audio') {
				// We stored picture in common during extractAudioMetadata; re-parse just to get the blob
				// music-metadata is already imported; parseBlob is cheap for covers since we reuse the File
				parseBlob(file, { skipCovers: false, duration: false }).then(parsed => {
					if (parsed.common.picture?.[0]) renderAlbumArt(parsed.common.picture[0]);
				}).catch(() => {});
			}
			dropzone.hidden = true;
			panel.hidden = false;
			results.hidden = false;
			result.hidden = true;
		}

		// ── Main file handler ─────────────────────────────────────────────────────
		async function handleFile(file) {
			if (!file) return;
			if (file.size > 250 * 1024 * 1024) { status.textContent = 'Files must be 250 MB or smaller'; return; }
			selectedKind = fileKind(file);
			if (!selectedKind) { status.textContent = 'Choose a JPG, PNG, WebP, TIFF, HEIC, MP3, WAV, M4A, FLAC, OGG, MP4, MOV, MKV, AVI, WEBM, PDF, DOCX, XLSX, or PPTX file'; return; }
			try {
				status.textContent = 'Inspecting metadata locally…';
				let parsed;
				if (selectedKind === 'pdf') {
					parsed = extractPdfMetadata(await PDFDocument.load(await file.arrayBuffer(), { updateMetadata: false }));
				} else if (selectedKind === 'office') {
					parsed = extractOfficeMetadata(await file.arrayBuffer());
				} else if (selectedKind === 'audio') {
					parsed = await extractAudioMetadata(file);
				} else if (selectedKind === 'video') {
					parsed = await extractVideoMetadata(file);
				} else {
					parsed = await extractImageMetadata(file);
				}
				selectedFile = file;
				cleanedBytes = undefined;
				metadata = parsed;
				const label = extension(file).toUpperCase();
				// Update the label text in the metadata head
				const metaLabelEl = document.querySelector('#meta-label');
				if (metaLabelEl) {
					metaLabelEl.textContent = selectedKind === 'audio' ? 'AUDIO INFORMATION' : selectedKind === 'video' ? 'VIDEO INFORMATION' : selectedKind === 'pdf' ? 'DOCUMENT INFORMATION' : selectedKind === 'office' ? 'DOCUMENT INFORMATION' : 'IMAGE INFORMATION';
				}
				setFileDetails(file, label);
				status.textContent = 'Scan complete';
			} catch (err) {
				console.error(err);
				selectedFile = undefined;
				if (selectedKind === 'pdf') {
					status.textContent = 'Unable to read this PDF. Password-protected PDFs are not supported.';
				} else if (selectedKind === 'office') {
					status.textContent = 'Unable to read metadata from this Office document.';
				} else if (selectedKind === 'audio') {
					status.textContent = 'Unable to read metadata from this audio file.';
				} else if (selectedKind === 'video') {
					status.textContent = 'Unable to read metadata from this video file.';
				} else {
					status.textContent = 'Unable to read metadata from this image.';
				}
			}
		}

		// ── Audio metadata (music-metadata) ────────────────────────────────────────────
		/**
		 * Readable label mapping for music-metadata common fields.
		 * We surface the most privacy-sensitive / user-visible fields first.
		 */
		const audioFieldMap = [
			['title',          'Title'],
			['artist',         'Artist'],
			['albumartist',    'Album artist'],
			['album',          'Album'],
			['year',           'Year'],
			['date',           'Date'],
			['genre',          'Genre'],
			['comment',        'Comment'],
			['composer',       'Composer'],
			['lyricist',       'Lyricist'],
			['track',          'Track'],
			['disk',           'Disk'],
			['copyright',      'Copyright'],
			['encodedby',      'Encoded by'],
			['encodersettings','Encoder settings'],
			['language',       'Language'],
			['grouping',       'Grouping'],
			['originalyear',   'Original year'],
			['originaldate',   'Original date'],
			['originalartist', 'Original artist'],
			['originalalbum',  'Original album'],
			['label',          'Label'],
			['website',        'Website'],
			['description',    'Description'],
			['isrc',           'ISRC'],
			['barcode',        'Barcode'],
			['mood',           'Mood'],
			['bpm',            'BPM'],
			['key',            'Key'],
			['replaygain_track_gain', 'ReplayGain track'],
			['replaygain_album_gain', 'ReplayGain album'],
		];

		/** Format a raw value from music-metadata into a display string. */
		function audioValueDisplay(v) {
			if (v === null || v === undefined) return null;
			if (typeof v === 'object' && 'no' in v) return v.no !== null ? String(v.no) + (v.of ? ` / ${v.of}` : '') : null;
			if (Array.isArray(v)) return v.join(', ');
			return String(v);
		}

		/** Render album art into the meta list (decorative row). */
		let albumArtObjectUrl = null;
		function renderAlbumArt(picture) {
			if (!picture || !picture.data) return;
			if (albumArtObjectUrl) URL.revokeObjectURL(albumArtObjectUrl);
			const blob = new Blob([picture.data], { type: picture.format || 'image/jpeg' });
			albumArtObjectUrl = URL.createObjectURL(blob);
			const item = document.createElement('div');
			item.className = 'meta-item meta-item--art';
			item.innerHTML = `<div><img src="${albumArtObjectUrl}" alt="Album art" class="album-art-thumb" /><strong>Album artwork</strong></div><small>Embedded image</small>`;
			metaList.prepend(item);
		}

		/** Extract metadata from an audio file using music-metadata. */
		const AUDIO_GROUP = 'Audio tags';
		async function extractAudioMetadata(file) {
			// Clean up previous album art object URL
			if (albumArtObjectUrl) { URL.revokeObjectURL(albumArtObjectUrl); albumArtObjectUrl = null; }
			const parsed = await parseBlob(file, { skipCovers: false, duration: false });
			const { common, native } = parsed;
			const rows = [];
			for (const [key, label] of audioFieldMap) {
				const val = audioValueDisplay(common[key]);
				if (val !== null && val !== '' && val !== 'undefined') rows.push([label, val, AUDIO_GROUP]);
			}
			// Surface any native tag keys not covered by common (e.g. custom ID3 frames)
			const knownKeys = new Set(audioFieldMap.map(([k]) => k));
			for (const [tagType, tags] of Object.entries(native || {})) {
				for (const tag of tags) {
					// Skip known common fields (already surfaced), binary covers, and duplicates
					if (tag.id === 'APIC' || tag.id === 'PIC' || tag.id === 'covr' || tag.id === 'METADATA_BLOCK_PICTURE') continue;
					if (knownKeys.has(tag.id.toLowerCase())) continue;
					const val = typeof tag.value === 'string' ? tag.value : typeof tag.value === 'number' ? String(tag.value) : null;
					if (!val || val.trim() === '') continue;
					rows.push([tag.id, val, tagType.toUpperCase()]);
				}
			}
			// Store album art separately for rendering (not in the rows count)
			const picture = common.picture?.[0];
			if (picture) rows.push(['Album artwork', `Embedded (${picture.format || 'image'})`, AUDIO_GROUP]);
			return rows;
		}

		// ── FFmpeg.wasm lazy loader ────────────────────────────────────────────
		let _ffmpeg = null;
		async function getFFmpeg() {
			if (_ffmpeg) return _ffmpeg;
			const { FFmpeg } = await import('https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.12.15/dist/esm/index.js');
			const { toBlobURL } = await import('https://cdn.jsdelivr.net/npm/@ffmpeg/util@0.12.2/dist/esm/index.js');
			const BASE = 'https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.10/dist/esm';
			_ffmpeg = new FFmpeg();
			await _ffmpeg.load({
				classWorkerURL: new URL('/ffmpeg/worker.js', window.location.origin).href,
				coreURL: await toBlobURL(`${BASE}/ffmpeg-core.js`, 'text/javascript'),
				wasmURL: await toBlobURL(`${BASE}/ffmpeg-core.wasm`, 'application/wasm'),
			});
			return _ffmpeg;
		}

		// ── Audio cleaning (FFmpeg – stream copy, no re-encode) ────────────────────
		/**
		 * Strip all metadata from an audio file using FFmpeg's stream copy mode.
		 * The audio bitstream is passed through unchanged — no re-encoding occurs.
		 * Flags used:
		 *   -map_metadata -1        → discard all global / stream metadata
		 *   -c copy                 → stream copy (no re-encoding)
		 *   -fflags +bitexact       → suppress FFmpeg's own encoder tag
		 *   -flags:a +bitexact      → (audio-stream level bitexact)
		 *   -vn                     → drop attached picture streams (album art)
		 */
		async function cleanAudio() {
			const ext = extension(selectedFile);
			const mime = audioFormats[ext] || selectedFile.type;
			const inName  = `in.${ext}`;
			const outName = `out.${ext}`;

			status.textContent = 'Loading audio processor…';
			const ffmpeg = await getFFmpeg();

			// Write the source file into FFmpeg's virtual FS in one chunk
			status.textContent = 'Stripping audio metadata…';
			const srcBuf = await selectedFile.arrayBuffer();
			await ffmpeg.writeFile(inName, new Uint8Array(srcBuf));

			// Run the strip command (stream copy — no transcoding)
			await ffmpeg.exec([
				'-i', inName,
				'-map_metadata', '-1',
				'-c', 'copy',
				'-vn',                      // drop embedded images (album art)
				'-fflags', '+bitexact',
				'-flags:a', '+bitexact',
				outName,
			]);

			const outData = await ffmpeg.readFile(outName);
			// Clean up virtual FS to free memory
			try { await ffmpeg.deleteFile(inName); } catch {}
			try { await ffmpeg.deleteFile(outName); } catch {}

			return { bytes: outData instanceof Uint8Array ? outData : new Uint8Array(outData), type: mime };
		}

		// ── Audio verification ────────────────────────────────────────────────────
		async function verifyCleanAudio(bytes, mime) {
			const ext = audioMimeToExt[mime] || 'mp3';
			const f = new File([bytes], `clean.${ext}`, { type: mime });
			return extractAudioMetadata(f);
		}

		// ── Progress bar helpers ──────────────────────────────────────────────
		const progressBar  = document.querySelector('#progress-bar');
		const progressFill = document.querySelector('#progress-fill');
		function setProgress(ratio) {
			// ratio: 0–1, or null to hide
			if (ratio === null) {
				progressBar.hidden = true;
				progressFill.style.width = '0%';
			} else {
				progressBar.hidden = false;
				progressFill.style.width = `${Math.min(100, Math.round(ratio * 100))}%`;
			}
		}

		// ── Video metadata extraction (FFmpeg ffmetadata dump) ───────────────
		/**
		 * Human-readable labels for common ffmetadata keys.
		 * Keys not in this map are shown with their raw key (title-cased).
		 */
		const videoMetaLabels = {
			title: 'Title', artist: 'Artist', author: 'Author', album: 'Album',
			comment: 'Comment', description: 'Description', synopsis: 'Synopsis',
			creation_time: 'Creation date', date: 'Date', year: 'Year',
			encoder: 'Encoder', encoded_by: 'Encoded by', copyright: 'Copyright',
			location: 'Location',
			'com.apple.quicktime.location.iso6709': 'GPS coordinates',
			'com.apple.quicktime.make':     'Camera make',
			'com.apple.quicktime.model':    'Camera model',
			'com.apple.quicktime.software': 'Software',
			make: 'Camera make', model: 'Camera model', genre: 'Genre',
			language: 'Language', handler_name: 'Stream handler',
			major_brand: 'Container format', compatible_brands: 'Compatible brands',
			vendor_id: 'Vendor', media_type: 'Media type',
		};
		// Technical/structural container keys skipped from privacy metadata inspection and verification counts
		const videoSkipKeys = new Set([
			'minor_version', 'itunes_cddb_1', 'itunes_cddb_tracknumber',
			'encoder', 'major_brand', 'compatible_brands',
			'vendor_id', 'language', 'handler_type'
		]);

		const genericHandlers = new Set([
			'videohandler', 'soundhandler', 'datahandler', 'hint',
			'core media video', 'core media audio', 'subtitlehandler',
			'subp', 'meta', 'appl', 'generic', 'handler', 'sound'
		]);

		function isGenericHandler(val) {
			const normalized = val.toLowerCase().replace(/[\s_-]+/g, ' ').trim();
			return genericHandlers.has(normalized);
		}

		function parseVideoMetadata(ffmetaText, logLines = []) {
			const rows = [];
			const seen = new Set();

			function addRow(rawKey, rawValue, section) {
				const key = rawKey.trim().toLowerCase();
				const value = rawValue.trim();
				if (!value || videoSkipKeys.has(key)) return;
				if (key === 'handler_name' && isGenericHandler(value)) return;
				const dedupeKey = key + '=' + value;
				if (seen.has(dedupeKey)) return;
				seen.add(dedupeKey);
				const label = videoMetaLabels[key]
					|| key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
				rows.push([label, value, section]);
			}

			// 1. Parse vmeta.txt (global container metadata)
			let section = 'Container tags';
			for (const rawLine of (ffmetaText || '').split('\n')) {
				const line = rawLine.trim();
				if (!line || line.startsWith(';')) continue;
				if (line.startsWith('[')) {
					section = 'Stream tags';
					continue;
				}
				const eq = line.indexOf('=');
				if (eq < 1) continue;
				addRow(line.slice(0, eq), line.slice(eq + 1), section);
			}

			// 2. Parse FFmpeg probe logs (stream-level & container tags)
			let currentSection = 'Container tags';
			let inMetadataBlock = false;

			for (const rawLine of logLines) {
				const line = String(rawLine);
				if (/^\s*Input #\d+/.test(line)) {
					currentSection = 'Container tags';
					inMetadataBlock = false;
					continue;
				}
				const streamMatch = line.match(/^\s*Stream #\d+:(\d+)(?:\[0x[0-9a-fA-F]+\])?(?:\(([a-zA-Z0-9_-]+)\))?:\s*([A-Za-z]+):/);
				if (streamMatch) {
					const streamType = streamMatch[3] || 'Stream';
					currentSection = `${streamType} stream tags`;
					inMetadataBlock = false;
					continue;
				}
				if (/^\s*Metadata:\s*$/.test(line)) {
					inMetadataBlock = true;
					continue;
				}
				if (inMetadataBlock) {
					if (/^\s*(Duration:|Stream #|Side data|Chapters:|Program|Output #|Stream mapping:)/.test(line)) {
						inMetadataBlock = false;
						continue;
					}
					const match = line.match(/^\s{4,}([a-zA-Z0-9_.:-]+)\s*:\s*(.+)$/);
					if (match) {
						addRow(match[1], match[2], currentSection);
					}
				}
			}

			return rows;
		}

		/**
		 * Extract metadata from a video file by running FFmpeg's ffmetadata muxer
		 * and capturing demuxer probe logs for stream-level tags.
		 * The input file is written to the WASM FS, metadata dumped to a text file,
		 * then both files are immediately deleted to keep memory usage minimal.
		 */
		async function extractVideoMetadata(file) {
			const ext  = extension(file);
			const inN  = `vi.${ext}`;
			const metN = 'vmeta.txt';
			status.textContent = 'Loading video scanner…';
			const ffmpeg = await getFFmpeg();
			status.textContent = 'Reading video metadata…';
			const buf = await file.arrayBuffer();
			await ffmpeg.writeFile(inN, new Uint8Array(buf));
			// arrayBuffer is no longer referenced; GC can collect it
			const logLines = [];
			const onLog = ({ type, message }) => {
				if (message) logLines.push(message);
			};
			ffmpeg.on('log', onLog);
			try {
				await ffmpeg.exec(['-i', inN, '-f', 'ffmetadata', '-y', metN]);
			} catch { /* ffmpeg returns non-zero when no audio/video streams — ignore */ }
			finally {
				ffmpeg.off('log', onLog);
			}
			let text = '';
			try { text = new TextDecoder().decode(await ffmpeg.readFile(metN)); } catch {}
			try { await ffmpeg.deleteFile(inN);  } catch {}
			try { await ffmpeg.deleteFile(metN); } catch {}
			return parseVideoMetadata(text, logLines);
		}

		// ── Video cleaning (FFmpeg stream copy, no re-encode) ─────────────────
		/**
		 * Strip all metadata from a video container using stream copy.
		 * Strategy:
		 *   -map_metadata -1   → drop all global metadata tags
		 *   -map_chapters -1   → drop chapter list
		 *   -c copy            → copy all streams verbatim (no re-encoding)
		 *   -map 0             → include all streams from the input
		 *   -y                 → overwrite output without asking
		 * After processing, the output file is read, immediately converted to a
		 * Blob URL (to avoid keeping 250 MB in JS heap), and both WASM FS files
		 * are deleted. The Uint8Array is then dereferenced.
		 *
		 * Returns { type, verifyRows } where verifyRows is the post-clean metadata
		 * scanned in-situ (before the WASM file is deleted), so we avoid a second
		 * full read-into-memory cycle.
		 */
		async function cleanVideo() {
			const ext     = extension(selectedFile);
			const mime    = videoFormats[ext] || selectedFile.type;
			const inN     = `vi.${ext}`;
			const outN    = `vo.${ext}`;
			const metN    = 'vo_meta.txt';

			status.textContent = 'Loading video processor…';
			const ffmpeg = await getFFmpeg();

			// Attach progress listener for the clean step
			const onProgress = ({ progress }) => {
				const pct = Math.round(Math.min(progress, 1) * 100);
				status.textContent = `Stripping video metadata… ${pct}%`;
				setProgress(Math.min(progress, 1));
			};
			ffmpeg.on('progress', onProgress);

			try {
				status.textContent = 'Writing video to memory…';
				setProgress(0);
				const srcBuf = await selectedFile.arrayBuffer();
				await ffmpeg.writeFile(inN, new Uint8Array(srcBuf));
				// srcBuf goes out of scope here; GC can collect it

				status.textContent = 'Stripping video metadata…';
				await ffmpeg.exec([
					'-i', inN,
					'-map_metadata', '-1',
					'-map_chapters', '-1',
					'-c', 'copy',
					'-map', '0',
					'-y', outN,
				]);

				// Verify: dump metadata from the output while it’s still in WASM FS
				let verifyRows = [];
				const verifyLogs = [];
				const onVerifyLog = ({ message }) => { if (message) verifyLogs.push(message); };
				ffmpeg.on('log', onVerifyLog);
				try {
					await ffmpeg.exec(['-i', outN, '-f', 'ffmetadata', '-y', metN]);
					const metData = await ffmpeg.readFile(metN);
					verifyRows = parseVideoMetadata(new TextDecoder().decode(metData), verifyLogs);
					try { await ffmpeg.deleteFile(metN); } catch {}
				} catch {}
				finally {
					ffmpeg.off('log', onVerifyLog);
				}

				// Read output into JS — then immediately create Blob URL and free array
				status.textContent = 'Finalizing…';
				setProgress(1);
				let outData = await ffmpeg.readFile(outN);
				if (!(outData instanceof Uint8Array)) outData = new Uint8Array(outData);

				// Revoke any previous video URL
				if (videoCleanedUrl) { URL.revokeObjectURL(videoCleanedUrl); videoCleanedUrl = null; }
				videoCleanedUrl = URL.createObjectURL(new Blob([outData], { type: mime }));
				// outData dereferenced — the only remaining reference to the bytes
				// is inside the browser’s Blob store, not our JS heap
				outData = null;

				return { type: mime, bytes: null, verifyRows };
			} finally {
				ffmpeg.off('progress', onProgress);
				setProgress(null);
				// Always clean up WASM FS entries to reclaim WASM heap
				try { await ffmpeg.deleteFile(inN);  } catch {}
				try { await ffmpeg.deleteFile(outN);  } catch {}
			}
		}

		// ── PDF cleaning ──────────────────────────────────────────────────────────
		async function cleanPdf() {
			const source = await PDFDocument.load(await selectedFile.arrayBuffer(), { updateMetadata: false });
			const clean = await PDFDocument.create({ updateMetadata: false });
			const pages = await clean.copyPages(source, source.getPageIndices());
			pages.forEach((p) => clean.addPage(p));
			return { bytes: await clean.save({ updateFieldAppearances: false, useObjectStreams: true }), type: 'application/pdf' };
		}

		// ── Image cleaning ────────────────────────────────────────────────────────
		async function imageBitmapFor(file) {
			const type = imageFormats[extension(file)];
			if (type === 'image/heic') return heicTo({ blob: file, type: 'bitmap' });
			if (type === 'image/tiff') {
				const bytes = await file.arrayBuffer();
				const ifd = UTIF.decode(bytes)[0];
				UTIF.decodeImage(bytes, ifd);
				const rgba = UTIF.toRGBA8(ifd);
				return createImageBitmap(new ImageData(new Uint8ClampedArray(rgba.buffer, rgba.byteOffset, rgba.byteLength), ifd.width, ifd.height));
			}
			return createImageBitmap(file, { imageOrientation: 'from-image' });
		}
		function canvasBlob(canvas, type, quality) { return new Promise((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Image encoder is unavailable')), type, quality)); }
		function joinBytes(chunks) { const length = chunks.reduce((t, c) => t + c.length, 0); const out = new Uint8Array(length); let off = 0; chunks.forEach((c) => { out.set(c, off); off += c.length; }); return out; }
		function stripJpegMetadata(source) { const bytes = new Uint8Array(source); if (bytes[0] !== 0xff || bytes[1] !== 0xd8) return bytes; const chunks = [bytes.slice(0, 2)]; let offset = 2; while (offset < bytes.length) { const start = offset; if (bytes[offset++] !== 0xff) return joinBytes([...chunks, bytes.slice(start)]); while (bytes[offset] === 0xff) offset++; const marker = bytes[offset++]; if (marker === 0xda || marker === 0xd9) return joinBytes([...chunks, bytes.slice(start)]); if (marker >= 0xd0 && marker <= 0xd7) { chunks.push(bytes.slice(start, offset)); continue; } const size = (bytes[offset] << 8) | bytes[offset + 1]; if (size < 2 || offset + size > bytes.length) return bytes; if (![0xe1, 0xe2, 0xed, 0xfe].includes(marker)) chunks.push(bytes.slice(start, offset + size)); offset += size; } return joinBytes(chunks); }
		function stripChunkMetadata(source, type) { const bytes = new Uint8Array(source); const png = type === 'image/png'; const webp = type === 'image/webp'; if ((!png || String.fromCharCode(...bytes.slice(1, 4)) !== 'PNG') && (!webp || String.fromCharCode(...bytes.slice(0, 4)) !== 'RIFF')) return bytes; const chunks = [bytes.slice(0, png ? 8 : 12)]; let offset = png ? 8 : 12; while (offset + 8 <= bytes.length) { const sizeOff = png ? offset : offset + 4; const nameOff = png ? offset + 4 : offset; const size = new DataView(bytes.buffer, bytes.byteOffset + sizeOff).getUint32(0, !png); const name = String.fromCharCode(...bytes.slice(nameOff, nameOff + 4)); const end = offset + 8 + size + (png ? 4 : size % 2); if (end > bytes.length) return bytes; if (!(png ? ['eXIf','iCCP','tEXt','zTXt','iTXt','tIME'].includes(name) : ['EXIF','ICCP','XMP '].includes(name))) chunks.push(bytes.slice(offset, end)); offset = end; } const out = joinBytes(chunks); if (webp) new DataView(out.buffer).setUint32(4, out.length - 8, true); return out; }
		function stripGeneratedMetadata(bytes, type) { return type === 'image/jpeg' ? stripJpegMetadata(bytes) : (type === 'image/png' || type === 'image/webp') ? stripChunkMetadata(bytes, type) : bytes; }
		async function cleanImage() {
			const sourceType = imageFormats[extension(selectedFile)];
			if (sourceType === 'image/tiff') {
				const source = await selectedFile.arrayBuffer();
				const ifd = UTIF.decode(source)[0];
				UTIF.decodeImage(source, ifd);
				const rgba = UTIF.toRGBA8(ifd);
				return { bytes: new Uint8Array(UTIF.encodeImage(rgba.buffer.slice(rgba.byteOffset, rgba.byteOffset + rgba.byteLength), ifd.width, ifd.height, { t305: [] })), type: 'image/tiff' };
			}
			if (sourceType === 'image/heic') {
				const blob = await heicTo({ blob: selectedFile, type: 'image/jpeg', quality: 0.9 });
				const bytes = await stripGeneratedMetadata(await blob.arrayBuffer(), 'image/jpeg');
				return { bytes, type: 'image/jpeg' };
			}
			const canvas = document.createElement('canvas');
			const bitmap = await imageBitmapFor(selectedFile);
			canvas.width = bitmap.width; canvas.height = bitmap.height;
			canvas.getContext('2d').drawImage(bitmap, 0, 0);
			const mime = sourceType === 'image/png' ? 'image/png' : 'image/jpeg';
			const blob = await canvasBlob(canvas, mime, 0.9);
			return { bytes: stripGeneratedMetadata(await blob.arrayBuffer(), mime), type: mime };
		}

		async function verifyCleanFile(bytes, mime) {
			if (selectedKind === 'video') return [];
			const ext = (audioMimeToExt[mime] || imageMimeToExt[mime] || 'bin');
			const f = new File([bytes], `clean.${ext}`, { type: mime });
			if (selectedKind === 'audio') return extractAudioMetadata(f);
			if (selectedKind === 'pdf') return extractPdfMetadata(await PDFDocument.load(await f.arrayBuffer(), { updateMetadata: false }));
			if (selectedKind === 'office') return extractOfficeMetadata(await f.arrayBuffer());
			if (selectedKind === 'image') return extractImageMetadata(f);
			return [];
		}

		// ── Master clean orchestrator ───────────────────────────────────────────────
		async function cleanFile() {
			if (!selectedFile) return;
			try {
				cleanButton.disabled = true;
				cleanButton.textContent = 'Creating clean file…';
				status.textContent = 'Removing metadata locally…';
				let cleaned;
				if (selectedKind === 'pdf') {
					cleaned = await cleanPdf();
				} else if (selectedKind === 'office') {
					cleaned = await cleanOfficeFile(selectedFile);
				} else if (selectedKind === 'audio') {
					cleaned = await cleanAudio();
				} else if (selectedKind === 'video') {
					cleaned = await cleanVideo();
				} else {
					cleaned = await cleanImage();
				}
				cleanedBytes = cleaned.bytes; // null for video (stored as Blob URL)
				cleanedType  = cleaned.type;
				// For video, verification was done in-situ inside cleanVideo()
				const remaining = selectedKind === 'video'
					? (cleaned.verifyRows ?? [])
					: await verifyCleanFile(cleaned.bytes, cleaned.type);
				document.querySelector('#after-count').textContent = `${remaining.length} field${remaining.length === 1 ? '' : 's'}`;
				const converted = selectedKind === 'image' && imageFormats[extension(selectedFile)] !== cleaned.type;
				const fileTypeName = selectedKind === 'pdf' ? 'PDF' : selectedKind === 'audio' ? extension(selectedFile).toUpperCase() : selectedKind === 'video' ? extension(selectedFile).toUpperCase() : selectedKind === 'office' ? extension(selectedFile).toUpperCase() : 'image';
				document.querySelector('#result-copy').textContent = remaining.length === 0
					? `Removed ${metadata.length} metadata field${metadata.length === 1 ? '' : 's'}. The generated ${fileTypeName} was checked again and has none remaining.${converted ? ' HEIC files are exported as JPG because browsers cannot encode HEIC.' : ''}`
					: `A clean file was generated, but ${remaining.length} metadata field${remaining.length === 1 ? '' : 's'} remain.`;
				results.hidden = true;
				result.hidden = false;
				status.textContent = remaining.length === 0 ? 'Metadata removed and verified' : 'Metadata cleanup needs review';
			} catch (err) {
				console.error(err);
				const isOOM = err?.message?.toLowerCase().includes('memory') || err?.name === 'RangeError';
				status.textContent = isOOM
					? 'Not enough memory to process this file. Try a smaller file or close other browser tabs.'
					: selectedKind === 'video' ? 'Unable to strip video metadata. The file may use an unsupported codec or container.'
					: 'Unable to create a clean file';
			} finally {
				cleanButton.disabled = false;
				cleanButton.innerHTML = 'Remove metadata <span>→</span>';
				setProgress(null);
			}
		}

		// ── Download ───────────────────────────────────────────────────────────
		function getDownloadExtension(type) {
			if (type === 'application/pdf') return 'pdf';
			if (type === 'image/png') return 'png';
			if (type === 'image/webp') return 'webp';
			if (type === 'image/tiff') return 'tiff';
			if (type === 'image/jpeg') return 'jpg';
			if (audioMimeToExt[type]) return audioMimeToExt[type];
			if (videoMimeToExt[type]) return videoMimeToExt[type];
			const officeMatch = Object.entries(officeExts).find(([, mime]) => mime === type);
			if (officeMatch) return officeMatch[0];
			return 'bin';
		}

		document.querySelector('#download-button').addEventListener('click', () => {
			const cleanName = selectedFile.name.replace(/\.[^.]+$/, `-clean.${getDownloadExtension(cleanedType)}`);
			if (selectedKind === 'video' && videoCleanedUrl) {
				const link = document.createElement('a');
				link.href = videoCleanedUrl;
				link.download = cleanName;
				link.click();
				return;
			}
			if (!cleanedBytes) return;
			const url = URL.createObjectURL(new Blob([cleanedBytes], { type: cleanedType }));
			const link = document.createElement('a');
			link.href = url;
			link.download = cleanName;
			link.click();
			setTimeout(() => URL.revokeObjectURL(url), 0);
		});

		// ── Drag / drop / browse ──────────────────────────────────────────────────
		const dzHeading = document.querySelector('#dz-heading');
		const DZ_DEFAULT_TEXT = 'Drop a file to inspect it';
		const DZ_DRAG_TEXT    = 'Drop your file here';

		// Make the entire dropzone clickable. Guard: if the click originated from
		// the browse button, it already calls input.click() via its own handler —
		// stop the event here so we don't open the picker twice.
		dropzone.addEventListener('click', (e) => {
			if (e.target === browse || browse.contains(e.target)) return;
			input.click();
		});

		browse.addEventListener('click', (e) => {
			e.stopPropagation(); // prevent bubbling to the dropzone click handler
			input.click();
		});

		input.addEventListener('change', (e) => handleFile(e.target.files[0]));

		// Use a counter instead of a boolean so that crossing child element
		// boundaries (which fire dragleave/dragenter pairs) doesn't flicker the class.
		let dragDepth = 0;

		dropzone.addEventListener('dragenter', (e) => {
			e.preventDefault();
			if (dragDepth === 0) {
				dropzone.classList.add('dragging');
				dzHeading.textContent = DZ_DRAG_TEXT;
			}
			dragDepth++;
		});

		dropzone.addEventListener('dragover', (e) => {
			e.preventDefault(); // required to allow drop
		});

		dropzone.addEventListener('dragleave', () => {
			dragDepth--;
			if (dragDepth === 0) {
				dropzone.classList.remove('dragging');
				dzHeading.textContent = DZ_DEFAULT_TEXT;
			}
		});

		dropzone.addEventListener('drop', (e) => {
			e.preventDefault();
			dragDepth = 0;
			dropzone.classList.remove('dragging');
			dzHeading.textContent = DZ_DEFAULT_TEXT;
			handleFile(e.dataTransfer.files[0]);
		});

		// Keyboard: Enter or Space activates the file picker (role="button" contract)
		dropzone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
		cleanButton.addEventListener('click', cleanFile);

		// ── Reset ─────────────────────────────────────────────────────────────────
		function reset() {
			input.value = '';
			selectedFile = undefined;
			cleanedBytes = undefined;
			cleanedType = undefined;
			metadata = [];
			panel.hidden = true;
			dropzone.hidden = false;
			status.textContent = 'Ready to scan';
			// Release album art URL if any
			if (albumArtObjectUrl) { URL.revokeObjectURL(albumArtObjectUrl); albumArtObjectUrl = null; }
			// Release video Blob URL if any
			if (videoCleanedUrl) { URL.revokeObjectURL(videoCleanedUrl); videoCleanedUrl = null; }
			setProgress(null);
		}
		document.querySelector('#reset-button').addEventListener('click', reset);
		document.querySelector('#again-button').addEventListener('click', reset);

		// ── Dark mode toggle ──────────────────────────────────────────────────────
		(function () {
			const html = document.documentElement;
			const btn  = document.querySelector('#theme-toggle');
			const KEY  = 'mc-theme';

			// Apply saved or system preference (also handles initial load)
			function applyTheme(dark) {
				html.classList.toggle('dark', dark);
				btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
				try { localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch {}
			}

			// Read stored preference; fall back to OS setting
			const stored = (() => { try { return localStorage.getItem(KEY); } catch { return null; } })();
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			applyTheme(stored === 'dark' || (stored === null && prefersDark));

			btn.addEventListener('click', () => applyTheme(!html.classList.contains('dark')));

			// Keep in sync if the user changes OS setting while tab is open (only when no saved preference)
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
				try { if (!localStorage.getItem(KEY)) applyTheme(e.matches); } catch { applyTheme(e.matches); }
			});
		})();
	</script>
</Layout>

