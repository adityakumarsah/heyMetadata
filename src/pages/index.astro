	<script>
		import { PDFDocument } from 'pdf-lib';
		import ExifReader from 'exifreader';
		import { heicTo } from 'heic-to';
		import * as UTIF from 'utif';
		import { unzipSync, zipSync, strToU8, strFromU8 } from 'fflate';
		import { parseBlob } from 'music-metadata';

		const input = document.querySelector('#file-input');
		const dropzone = document.querySelector('#dropzone');
		const browse = document.querySelector('#browse-button');
		const panel = document.querySelector('#file-panel');
		const results = document.querySelector('#scan-results');
		const result = document.querySelector('#clean-result');
		const metaList = document.querySelector('#meta-list');
		const status = document.querySelector('#scanner-status');
		const cleanButton = document.querySelector('#clean-button');

		// ── FAQ Accordion Exclusive Toggle ─────────────────────────────────────────
		const faqItems = document.querySelectorAll('.faq-item') as NodeListOf<HTMLDetailsElement>;
		faqItems.forEach((item) => {
