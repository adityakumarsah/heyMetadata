---
import Layout from '../layouts/Layout.astro';

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": "What is EXIF data?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "EXIF (Exchangeable Image File Format) is metadata embedded in digital image files that stores technical information about the photo. It can include details such as the camera make and model, shutter speed, aperture, ISO, date and time the photo was taken, and, on devices with location services enabled, GPS coordinates. HeyMetadata's built-in EXIF data viewer lets you see the metadata embedded in your image before removing it."
			}
		},
		{
			"@type": "Question",
			"name": "How does HeyMetadata remove metadata?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Drop or select a file, and HeyMetadata scans it for available metadata such as EXIF, IPTC, XMP, GPS information, document properties, and audio tags. When you click “Remove metadata,” a cleaned copy is generated directly in your browser. HeyMetadata then re-scans the processed file to verify that the metadata fields it can remove have been stripped before providing the cleaned file for download."
			}
		},
		{
			"@type": "Question",
			"name": "Is HeyMetadata really free?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Yes. HeyMetadata is completely free with no sign-up, no watermarks, and no file limits beyond the 250 MB browser processing cap. There are no premium tiers or hidden fees."
			}
		},
		{
			"@type": "Question",
			"name": "Are my files uploaded to a server?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "No. HeyMetadata runs entirely in your browser tab. Your files are never uploaded, stored, or transmitted. All processing happens locally on your device using JavaScript and WebAssembly."
			}
		},
		{
			"@type": "Question",
			"name": "Does removing metadata affect file quality?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "For images, a canvas re-draw is used so there may be minor quality differences at the pixel level. For video and audio, HeyMetadata uses stream-copy mode — the media bitstream is passed through unchanged with no re-encoding, so quality is preserved exactly."
			}
		}
	]
};
