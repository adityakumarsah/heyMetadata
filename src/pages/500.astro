---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="500 — Server Error | HeyMetadata"
  description="An unexpected error occurred. Return to HeyMetadata to strip metadata and EXIF data from photos, videos, and documents safely."
  canonicalUrl="https://heymetadata.com/500"
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <main>
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label="HeyMetadata home"><span class="brand-mark">✦</span> HeyMetadata</a>
      <div class="nav-links">
        <a href="/#how-it-works">How it works</a>
        <a href="/#formats">Supported files</a>
        <a href="/#privacy">Privacy</a>
        <a href="/about">About Us</a>
      </div>
      <div class="nav-actions">
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
          <span class="theme-icon theme-icon--sun" aria-hidden="true">☀︎</span>
          <span class="theme-icon theme-icon--moon" aria-hidden="true">☽</span>
        </button>
        <a class="nav-cta" href="/#cleaner">Clean a file <span>↗</span></a>
      </div>
    </nav>

    <div class="error-container">
      <div class="hero-glow" aria-hidden="true"></div>

      <span class="error-code">500</span>
      <h1 class="error-title">Internal Server Error</h1>
      <p class="error-message">
        Something unexpected happened on our end. Rest assured, because HeyMetadata runs locally in your browser, your files and personal data remain 100% safe on your device.
      </p>

      <div class="error-actions">
        <a href="/" class="btn-primary">Return to Homepage ↗</a>
        <a href="/contact" class="btn-secondary">Report Issue</a>
      </div>
    </div>

    <footer>
      <a class="brand" href="/" aria-label="HeyMetadata home"><span class="brand-mark">✦</span> HeyMetadata</a>
      <p>Free Online Metadata Remover — Remove EXIF Data Privately</p>
      <div class="footer-links">
        <a href="/about">About Us</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
        <a href="/contact">Contact Us</a>
      </div>
      <span>© 2026 HeyMetadata</span>
    </footer>
  </main>

  <script>
    (function () {
      const html = document.documentElement;
      const btn  = document.querySelector('#theme-toggle');
      const KEY  = 'mc-theme';
      if (!btn) return;
      function applyTheme(dark) {
        html.classList.toggle('dark', dark);
        btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        try { localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch {}
      }
      const stored = (() => { try { return localStorage.getItem(KEY); } catch { return null; } })();
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      applyTheme(stored === 'dark' || (stored === null && prefersDark));
      btn.addEventListener('click', () => applyTheme(!html.classList.contains('dark')));
    })();
  </script>
</Layout>

<style>
:root {
  --fg: #171717;
  --fg-muted: #666;
  --fg-subtle: #999;
  --border: #e8e8e8;
  --border-light: #eee;
  --surface: #fff;
  --surface-2: #fafafa;
  --nav-link: #666;
  --toggle-bg: #f0f0f0;
  --toggle-fg: #444;
  --toggle-hover-bg: #e2e2e2;
}

:global(html.dark) {
  --fg: #f0f0f0;
  --fg-muted: #a0a0a0;
  --fg-subtle: #666;
  --border: #2a2d35;
  --border-light: #252830;
  --surface: #13161e;
  --surface-2: #181b24;
  --nav-link: #a0a0a0;
  --toggle-bg: #1e2130;
  --toggle-fg: #c0c8e0;
  --toggle-hover-bg: #252a3a;
}

:global(*) { box-sizing: border-box; }
:global(html) { scroll-behavior: smooth; }
:global(body) {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--fg);
  transition: background-color .3s, color .3s;
}

main { overflow: visible; }
.nav { height: 64px; max-width: 1200px; margin: auto; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; }
.brand { font-weight: 650; letter-spacing: -.8px; color: var(--fg); text-decoration: none; font-size: 18px; display: flex; align-items: center; gap: 8px; }
.brand-mark { font-size: 20px; }
.nav-links { display: flex; gap: 26px; }
.nav-links a { font-size: 14px; color: var(--nav-link); text-decoration: none; }
.nav-actions { display: flex; align-items: center; gap: 10px; }
.nav-cta { font-size: 14px; background: var(--fg); color: var(--surface); text-decoration: none; padding: 9px 13px; border-radius: 6px; transition: opacity .15s; }
.nav-cta span { margin-left: 7px; }

.theme-toggle {
  width: 36px; height: 36px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--toggle-bg);
  color: var(--toggle-fg);
  cursor: pointer;
  display: grid; place-items: center;
  font-size: 17px;
  transition: background .2s, border-color .2s, transform .15s;
  position: relative;
  overflow: hidden;
  padding: 0;
}
.theme-toggle:hover { background: var(--toggle-hover-bg); transform: scale(1.07); }
.theme-icon { position: absolute; transition: opacity .25s, transform .25s; line-height: 1; }
.theme-icon--sun  { opacity: 1; transform: rotate(0deg) scale(1); }
.theme-icon--moon { opacity: 0; transform: rotate(-90deg) scale(.6); }
:global(html.dark) .theme-icon--sun  { opacity: 0; transform: rotate(90deg) scale(.6); }
:global(html.dark) .theme-icon--moon { opacity: 1; transform: rotate(0deg) scale(1); }

.error-container {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 100px 28px 120px;
  text-align: center;
}

.hero-glow {
  position: absolute;
  width: 500px;
  height: 250px;
  left: 50%;
  top: 40px;
  transform: translateX(-50%);
  background: radial-gradient(circle at 50% 50%, rgba(255, 0, 128, 0.12), transparent 70%);
  filter: blur(40px);
  pointer-events: none;
}

.error-code {
  display: inline-block;
  font-size: clamp(80px, 12vw, 130px);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -.06em;
  background: linear-gradient(135deg, #ff0080, #7928ca);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 8px;
}

.error-title {
  font-size: clamp(28px, 4vw, 42px);
  letter-spacing: -.03em;
  font-weight: 650;
  margin: 0 0 16px;
  color: var(--fg);
}

.error-message {
  font-size: 17px;
  line-height: 1.6;
  color: var(--fg-muted);
  max-width: 540px;
  margin: 0 auto 36px;
}

.error-actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}

.btn-primary {
  background: var(--fg);
  color: var(--surface);
  text-decoration: none;
  font-size: 15px;
  font-weight: 550;
  padding: 12px 24px;
  border-radius: 8px;
  transition: opacity .15s;
}
.btn-primary:hover {
  opacity: .9;
}

.btn-secondary {
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--fg);
  text-decoration: none;
  font-size: 15px;
  font-weight: 550;
  padding: 12px 24px;
  border-radius: 8px;
  transition: border-color .15s;
}
.btn-secondary:hover {
  border-color: var(--fg-subtle);
}

footer { max-width: 1200px; border-top: 1px solid var(--border-light); margin: auto; padding: 29px 28px 35px; display: flex; align-items: center; gap: 22px; color: var(--fg-muted); font-size: 12px; flex-wrap: wrap; }
footer p { margin: 0; }
.footer-links { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
.footer-links a { color: var(--fg-muted); text-decoration: none; transition: color .15s; white-space: nowrap; }
.footer-links a:hover { color: var(--fg); text-decoration: underline; }
footer > span { margin-left: auto; }

@media (max-width: 700px) {
  .nav-links { display: none; }
  .nav { padding: 0 18px; }
  .error-container { padding: 60px 18px 80px; }
  footer { flex-wrap: wrap; gap: 14px; }
  .footer-links { flex-wrap: wrap; gap: 12px; width: 100%; }
  footer > span { margin-left: 0; }
}
</style>
