  --error-fg: #cf1322;
}

:global(html.dark) {
  --fg: #f0f0f0;
  --fg-muted: #a0a0a0;
  --fg-subtle: #666;
  --border: #2a2d35;
  --border-light: #252830;
  --border-section: #2a2d35;
  --surface: #13161e;
  --surface-2: #181b24;
  --surface-3: #1e2130;
  --nav-link: #a0a0a0;
  --hero-border: #1e2130;
  --cleaner-shadow: 0 18px 50px #00000040, 0 2px 7px #00000020;
  --file-type-bg: #0f2040;
  --file-type-fg: #5ba3ff;
  --scan-chip-fg: #4cd9a0;
  --scan-chip-border: #1a3d2e;
  --scan-chip-bg: #0a1f17;
  --success-bg: #0a2418;
  --success-fg: #4cd9a0;
  --after-strong: #4cd9a0;
  --toggle-bg: #1e2130;
  --toggle-fg: #c0c8e0;
  --toggle-hover-bg: #252a3a;
  --error-bg: #2a1215;
  --error-border: #5c1d24;
  --error-fg: #ff7875;
}

:global(*) { box-sizing: border-box; }
:global(html) { scroll-behavior: smooth; }
:global(body) {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--fg);
  transition: background-color .3s, color .3s;
}

main { overflow: visible; }
.nav { height: 64px; max-width: 1200px; margin: auto; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; }
.brand { font-weight: 650; letter-spacing: -.8px; color: var(--fg); text-decoration: none; font-size: 18px; display: flex; align-items: center; gap: 8px; }
.brand-mark { font-size: 20px; }
.nav-links { display: flex; gap: 26px; }
.nav-links a { font-size: 14px; color: var(--nav-link); text-decoration: none; }
.nav-links a.active { color: var(--fg); font-weight: 600; }
.nav-actions { display: flex; align-items: center; gap: 10px; }
.nav-cta { font-size: 14px; background: var(--fg); color: var(--surface); text-decoration: none; padding: 9px 13px; border-radius: 6px; transition: opacity .15s; }
.nav-cta span { margin-left: 7px; }

/* ── Theme toggle ──────────────────────────────────────────────────────────── */
.theme-toggle {
  width: 36px; height: 36px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--toggle-bg);
  color: var(--toggle-fg);
  cursor: pointer;
  display: grid; place-items: center;
  font-size: 17px;
  transition: background .2s, border-color .2s, transform .15s;
