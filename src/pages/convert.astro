}
.theme-toggle:hover { background: var(--toggle-hover-bg); transform: scale(1.07); }
.theme-icon { position: absolute; transition: opacity .25s, transform .25s; line-height: 1; }
.theme-icon--sun  { opacity: 1; transform: rotate(0deg) scale(1); }
.theme-icon--moon { opacity: 0; transform: rotate(-90deg) scale(.6); }
:global(html.dark) .theme-icon--sun  { opacity: 0; transform: rotate(90deg) scale(.6); }
:global(html.dark) .theme-icon--moon { opacity: 1; transform: rotate(0deg) scale(1); }

/* ── Hero ──────────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  text-align: center;
  padding: 12px 24px 61px;
  border-top: 1px solid var(--hero-border);
  background:
    radial-gradient(ellipse 80% 40% at 50% -30%, #ddecff 0%, rgba(232,243,255,.5) 40%, transparent 70%),
    radial-gradient(ellipse 50% 20% at 12% 100%, rgba(211,255,245,.25), transparent 70%),
    radial-gradient(ellipse 50% 20% at 88% 100%, rgba(237,219,255,.25), transparent 70%);
}
:global(html.dark) .hero {
  background:
    radial-gradient(ellipse 80% 40% at 50% -30%, #0d1f3a 0%, rgba(13,20,38,.6) 40%, transparent 70%),
    radial-gradient(ellipse 50% 20% at 12% 100%, rgba(0,40,30,.25), transparent 70%),
    radial-gradient(ellipse 50% 20% at 88% 100%, rgba(30,10,50,.25), transparent 70%);
}
.hero-glow { position: absolute; width: 650px; height: 320px; left: 50%; top: -120px; transform: translateX(-50%); background: radial-gradient(circle at 25% 50%, #b8f4ea55, transparent 30%), radial-gradient(circle at 70% 45%, #e3c7ff60, transparent 30%), radial-gradient(circle at 50% 75%, #aed5ff50, transparent 32%); filter: blur(32px); pointer-events: none; opacity: 0.7; }
.hero > * { position: relative; }
.hero > .hero-glow { position: absolute; }
.eyebrow { font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .07em; color: var(--fg-muted); margin: 0 0 12px; display: flex; justify-content: center; align-items: center; gap: 8px; }
.eyebrow span { width: 7px; height: 7px; background: var(--fg); border-radius: 50%; }
.hero h1 { font-size: clamp(45px, 6vw, 76px); letter-spacing: -.075em; line-height: .97; font-weight: 620; margin: 0; text-wrap: balance; color: var(--fg); }
.hero h1 em { font-style: normal; background: linear-gradient(90deg, #007cf0, #7928ca 48%, #ff0080); background-clip: text; -webkit-background-clip: text; color: transparent; }
.hero-copy { max-width: 520px; margin: 14px auto 22px; font-size: 17px; line-height: 1.5; color: var(--fg-muted); }

/* ── Cleaner / Converter Card ──────────────────────────────────────────────── */
.cleaner { width: min(100%, 650px); margin: 0 auto; background: var(--surface); text-align: left; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--cleaner-shadow); overflow: hidden; }
.cleaner-top { height: 42px; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; padding: 0 16px; font-size: 12.5px; color: var(--fg-muted); gap: 7px; }
.progress-bar { height: 3px; background: var(--border-light); overflow: hidden; width: 100%; }
.progress-bar[hidden] { display: none; }
.progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #007cf0, #7928ca 50%, #ff0080); transition: width .15s ease; }
.status-dot { width: 7px; height: 7px; background: #15b97a; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 0 2px color-mix(in srgb, #15b97a 20%, transparent); }
.local-note { margin-left: auto; font-size: 11.5px; color: var(--fg-subtle); display: flex; align-items: center; gap: 4px; }

/* ── Error Banner ──────────────────────────────────────────────────────────── */
.error-banner {
  margin: 12px 12px 0;
  padding: 10px 14px;
  background: var(--error-bg);
  border: 1px solid var(--error-border);
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--error-fg);
  font-size: 13px;
}
.error-banner[hidden] { display: none; }
.error-banner__icon { font-weight: bold; font-size: 15px; }
.error-banner__text { flex: 1; line-height: 1.4; }
.error-banner__close {
  background: transparent;
  border: none;
  color: var(--error-fg);
  font-size: 18px;
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
}

/* ── Dropzone ──────────────────────────────────────────────────────────────── */
.dropzone {
  margin: 12px;
  border: 1.5px dashed var(--border);
  border-radius: 10px;
  min-height: 230px;
  display: flex; align-items: center; justify-content: center; flex-direction: column;
  text-align: center;
  padding: 24px 20px 18px;
  cursor: pointer;
  transition: border-color .2s, background-color .2s, box-shadow .2s;
  position: relative;
}
.dropzone:hover {
  border-color: var(--fg-muted);
  background: var(--surface-2);
}
.dropzone:focus-visible {
  outline: none;
  border-color: #0070f3;
  box-shadow: 0 0 0 3px rgba(0,112,243,.15);
}
.dropzone.dragging {
  border-color: var(--fg);
  border-style: solid;
  background: var(--surface-2);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--fg) 8%, transparent);
}

.upload-icon {
  width: 44px; height: 44px;
  display: grid; place-items: center;
  border-radius: 10px;
  border: 1.5px solid var(--border);
  background: var(--surface-2);
  color: var(--fg-muted);
  margin-bottom: 20px;
  transition: border-color .2s, color .2s, transform .2s;
}
.dropzone:hover .upload-icon {
  border-color: var(--fg-muted);
  color: var(--fg);
  transform: translateY(-2px);
}
.dropzone.dragging .upload-icon {
  border-color: var(--fg);
  color: var(--fg);
  transform: translateY(-3px) scale(1.05);
}

.dropzone h2 { margin: 0; font-size: 17px; letter-spacing: -.4px; color: var(--fg); font-weight: 580; }
.dropzone p { font-size: 13.5px; color: var(--fg-muted); margin: 10px 0 0; }
.text-button { border: 0; background: none; font: inherit; color: var(--fg); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; padding: 0; }

.format-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 22px; max-width: 480px; }
.chip {
  font: 11px ui-monospace, monospace;
  letter-spacing: .05em;
