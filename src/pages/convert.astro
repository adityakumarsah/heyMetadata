---
import Layout from '../layouts/Layout.astro';

const converterFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does the client-side image converter work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "HeyMetadata converts images directly inside your web browser using HTML5 Canvas and ImageBitmap APIs. When you select an image, the browser automatically detects its format and enables a dropdown to select your target format (JPG, JPEG, PNG, WebP, or AVIF). The image is re-encoded locally without sending any data over the network."
      }
    },
    {
      "@type": "Question",
      "name": "Are my images uploaded to any server during conversion?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The entire conversion runs 100% client-side on your device. Your images are never uploaded, stored, or sent to any remote server or third party."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between JPG and JPEG output options?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JPG and JPEG use the exact same underlying JPEG image compression format, but some submission portals and government forms strictly require either a .jpg or .jpeg file extension. HeyMetadata lets you choose either extension directly."
      }
    },
    {
      "@type": "Question",
      "name": "What image formats are supported for conversion?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We support dynamic conversions between JPG, JPEG, PNG, WebP, and AVIF formats: convert between any pair of formats including JPG to JPEG, JPEG to JPG, PNG to JPG/JPEG/WebP/AVIF, and AVIF to JPG/JPEG/PNG/WebP."
      }
    },
    {
      "@type": "Question",
      "name": "Does image conversion affect resolution or quality?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Original pixel dimensions are preserved exactly 1:1. For PNG output, conversion is lossless. For JPG, JPEG, WebP, and AVIF, high-fidelity encoding settings (92% quality default) are used to ensure sharp results without visual degradation."
      }
    },
    {
      "@type": "Question",
      "name": "What happens to transparent backgrounds when converting to JPG or JPEG?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Because JPEG format does not support transparency, transparent areas are automatically composited onto a clean white background during conversion."
      }
    }
  ]
};

const converterAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "HeyMetadata — Image Converter",
  "url": "https://heymetadata.com/convert",
  "description": "Free online client-side image converter. Convert JPG, JPEG, PNG, WebP, and AVIF images privately in your browser without uploading files.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "Any (Web Browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Convert between JPG, JPEG, PNG, WebP, and AVIF formats",
    "Convert JPG to JPEG and JPEG to JPG with custom extensions",
    "Dynamic format detection and output selection",
    "100% client-side conversion in your browser",
    "Zero file uploads for absolute privacy",
    "Preserve 1:1 image dimensions and high fidelity"
  ],
  "creator": {
    "@type": "Organization",
    "name": "HeyMetadata"
  }
};
---

<Layout
  title="Image Converter — Convert JPG, JPEG, PNG, WebP & AVIF Online | HeyMetadata"
  description="Free private online image converter. Convert JPG, JPEG, PNG, WebP, and AVIF images directly in your browser. Fast, 100% client-side — your files never leave your device."
  keywords="image converter, convert jpg to jpeg, convert jpeg to jpg, convert jpg to png, convert png to jpg, convert png to jpeg, convert webp to jpg, convert webp to jpeg, convert avif to jpg, convert avif to jpeg, convert jpg to avif, online image converter, private image converter, client side image converter"
  canonicalUrl="https://heymetadata.com/convert"
>
  <main>
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label="HeyMetadata home">
        <span class="brand-mark">✦</span> HeyMetadata
      </a>
      <div class="nav-links">
        <a href="/">Metadata Remover</a>
        <a href="/convert" class="active" aria-current="page">Image Converter</a>
        <a href="/#how-it-works">How it works</a>
        <a href="/#privacy">Privacy</a>
        <a href="/about">About Us</a>
      </div>
      <div class="nav-actions">
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
          <span class="theme-icon theme-icon--sun" aria-hidden="true">☀︎</span>
          <span class="theme-icon theme-icon--moon" aria-hidden="true">☽</span>
        </button>
        <a class="nav-cta" href="/#cleaner">Clean a file <span>↗</span></a>
      </div>
    </nav>

    <section class="hero" id="converter">
      <div class="hero-glow" aria-hidden="true"></div>
      <p class="eyebrow"><span></span> 100% PRIVATE CLIENT-SIDE IMAGE CONVERTER</p>
      <h1>Convert Images.<br /><em>Preserve Your Privacy.</em></h1>
      <p class="hero-copy">Upload a <strong>JPG</strong>, <strong>JPEG</strong>, <strong>PNG</strong>, <strong>WebP</strong>, or <strong>AVIF</strong> image to convert it directly in your browser. Zero server uploads, high quality, and 100% private.</p>

      <div class="cleaner" id="converter-card">
        <div class="cleaner-top">
          <span class="status-dot" id="status-dot"></span>
          <span id="converter-status">Ready to convert</span>
          <span class="local-note">
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="5" width="8" height="6" rx="1"/>
              <path d="M4 5V3.5a2 2 0 0 1 4 0V5"/>
            </svg>
            100% Client-Side
          </span>
        </div>

        <div class="progress-bar" id="progress-bar" hidden aria-hidden="true">
          <div class="progress-fill" id="progress-fill"></div>
        </div>

        <!-- Alert Error Box -->
        <div class="error-banner" id="error-banner" hidden role="alert">
          <div class="error-banner__icon">⚠</div>
          <div class="error-banner__text" id="error-message">An error occurred.</div>
          <button type="button" class="error-banner__close" id="error-close" aria-label="Dismiss error">×</button>
        </div>

        <!-- Dropzone Section -->
        <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Upload an image to convert">
          <input
            id="file-input"
            name="image"
            type="file"
            hidden
            accept="image/jpeg,image/png,image/webp,image/avif,.jpg,.jpeg,.png,.webp,.avif"
            aria-label="Choose an image file to convert"
          />
          <div class="upload-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13V4M6 7l4-4 4 4"/>
              <path d="M3 14v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1"/>
            </svg>
          </div>
          <h2 id="dz-heading">Drop a JPG, JPEG, PNG, WebP, or AVIF image to convert</h2>
          <p>or <button type="button" class="text-button" id="browse-button">browse your device</button></p>
          <div class="format-chips" aria-label="Supported conversion formats">
            <span class="chip">JPG</span>
            <span class="chip">JPEG</span>
            <span class="chip">PNG</span>
            <span class="chip">WEBP</span>
            <span class="chip">AVIF</span>
          </div>
          <p class="dz-privacy">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="5" width="8" height="6" rx="1"/>
              <path d="M4 5V3.5a2 2 0 0 1 4 0V5"/>
            </svg>
            Processed entirely on your device · zero data leaves your browser
          </p>
        </div>

        <!-- Conversion Panel Section -->
        <div class="file-panel" id="file-panel" hidden>
          <!-- Source File Header -->
          <div class="file-summary">
            <div class="file-type" id="file-type">JPG</div>
            <div class="file-info-group">
              <strong id="file-name">image.jpg</strong>
              <div class="file-specs">
                <span id="file-size">0 KB</span>
                <span class="specs-dot">·</span>
                <span id="file-dimensions">0 × 0 px</span>
              </div>
            </div>
            <button class="icon-button" id="reset-button" aria-label="Remove selected image" title="Remove selected image">×</button>
          </div>

          <!-- Configuration & Preview Stage -->
          <div class="convert-controls" id="convert-controls">
            <div class="preview-container">
              <div class="preview-box">
                <img id="source-preview" alt="Source image preview" class="preview-img" />
              </div>
            </div>

            <!-- Single "Convert to" Dropdown block -->
            <div class="format-selector-block">
              <div class="field-label-row">
                <label for="target-format-select" class="control-label">CONVERT TO</label>
                <span class="hint-badge" id="detected-format-badge">Detected: <strong id="detected-format-text">JPG</strong></span>
              </div>

              <div class="select-wrapper">
                <select id="target-format-select" class="custom-select" aria-label="Select output format">
                  <!-- Dynamically populated with options -->
                </select>
                <div class="select-arrow" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 4.5l3 3 3-3"/>
                  </svg>
                </div>
              </div>
            </div>

            <div class="quality-selector-block" id="quality-selector-block">
              <div class="field-label-row">
                <label for="quality-slider" class="control-label">OUTPUT QUALITY</label>
                <span class="quality-val" id="quality-val">92%</span>
              </div>
              <input
                type="range"
                id="quality-slider"
                min="50"
                max="100"
                value="92"
                step="1"
                class="range-slider"
                aria-label="Image output quality slider"
              />
              <div class="slider-ticks">
                <span>Smaller size</span>
                <span>Default (92%)</span>
                <span>Maximum</span>
              </div>
            </div>

            <button type="button" class="primary-button" id="convert-button">
              Convert Image <span aria-hidden="true">→</span>
            </button>
          </div>

          <!-- Result Stage -->
          <div class="clean-result" id="conversion-result" hidden>
            <div class="success-icon">✓</div>
            <p class="label">CONVERSION COMPLETE</p>
            <h2>Your converted image is ready.</h2>
            <p id="result-copy">Successfully converted without leaving your browser.</p>

            <div class="result-preview-container">
              <img id="result-preview" alt="Converted image preview" class="preview-img result-thumb" />
            </div>

            <div class="comparison">
              <div>
                <span>Original (<span id="source-fmt-label">JPG</span>)</span>
                <strong id="before-size">0 KB</strong>
              </div>
              <div class="arrow" aria-hidden="true">→</div>
              <div class="after">
                <span>Converted (<span id="target-fmt-label">JPEG</span>)</span>
                <strong id="after-size">0 KB</strong>
              </div>
            </div>

            <button type="button" class="primary-button" id="download-button">
              Download <span id="download-ext-label">JPEG</span> <span aria-hidden="true">↓</span>
            </button>
            <button type="button" class="again-button" id="again-button">
              Convert another image
            </button>
          </div>
        </div>
      </div>

      <div class="trust-row">
        <span>✓ 100% In-Browser Execution</span>
        <span>✓ Zero Server Uploads</span>
        <span>✓ Pixel-Perfect Quality</span>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="steps" id="how-it-works">
      <p class="eyebrow"><span></span> HOW IT WORKS</p>
      <h2>Client-Side Image Conversion in 3 Steps</h2>
      <div class="step-grid">
        <article>
          <b>01</b>
          <h3>Select Your Image</h3>
          <p>Drag and drop any JPG, JPEG, PNG, WebP, or AVIF image. Your file is read locally by your browser tab without transmitting any data over the internet.</p>
        </article>
        <article>
          <b>02</b>
          <h3>Choose Target Format</h3>
          <p>The input format is automatically detected. Select your desired output format from the dropdown (JPG, JPEG, PNG, WebP, or AVIF) and fine-tune output quality.</p>
        </article>
        <article>
          <b>03</b>
          <h3>Download Converted File</h3>
          <p>Preview the converted image and download it directly to your device with the exact chosen file extension (.jpg, .jpeg, .png, .webp, or .avif).</p>
        </article>
      </div>
    </section>

    <!-- Privacy Feature Band -->
    <section class="privacy-band" id="privacy">
      <div>
        <p class="eyebrow"><span></span> PRIVATE &amp; SECURE</p>
        <h2>Never Send Your Photos to Unknown Servers</h2>
      </div>
      <p>Most online converters upload your personal photos, screenshots, and confidential documents to cloud servers where they can be cached, analyzed, or leaked. HeyMetadata executes the entire conversion locally on your device using Web APIs. Close the tab, and everything is completely gone from memory.</p>
      <div class="privacy-art" aria-hidden="true">
        <div class="orb"></div>
        <div class="orbit a"></div>
        <div class="orbit b"></div>
        <div class="lock">⌑</div>
      </div>
    </section>

    <!-- Supported Conversion Combinations Grid -->
    <section class="formats" id="supported-conversions">
      <p class="eyebrow"><span></span> SUPPORTED FORMATS</p>
      <h2>Available Image Conversions</h2>
      <div class="format-grid">
        <div><strong>JPG ↔ JPEG</strong><span>Extension conversion</span></div>
        <div><strong>JPG → PNG</strong><span>Lossless conversion</span></div>
        <div><strong>JPG → WEBP</strong><span>Next-gen compression</span></div>
        <div><strong>JPG → AVIF</strong><span>High efficiency</span></div>
        <div><strong>PNG → JPG</strong><span>Standard JPEG photo</span></div>
        <div><strong>PNG → JPEG</strong><span>Full .jpeg extension</span></div>
        <div><strong>PNG → WEBP</strong><span>Modern web image</span></div>
        <div><strong>PNG → AVIF</strong><span>Maximum compression</span></div>
        <div><strong>WEBP → JPG</strong><span>Universal photo (.jpg)</span></div>
        <div><strong>WEBP → JPEG</strong><span>Universal photo (.jpeg)</span></div>
        <div><strong>WEBP → PNG</strong><span>Preserve transparency</span></div>
        <div><strong>WEBP → AVIF</strong><span>Next-gen upgrade</span></div>
        <div><strong>AVIF → JPG</strong><span>Standard JPEG (.jpg)</span></div>
        <div><strong>AVIF → JPEG</strong><span>Standard JPEG (.jpeg)</span></div>
        <div><strong>AVIF → PNG</strong><span>Lossless export</span></div>
        <div><strong>AVIF → WEBP</strong><span>Web compatibility</span></div>
      </div>
    </section>

    <!-- SEO FAQ Section -->
    <section class="seo-faq" id="faq">
      <p class="eyebrow"><span></span> FREQUENTLY ASKED QUESTIONS</p>
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item" name="faq">
          <summary>How does the client-side image converter work?</summary>
          <div class="faq-answer">
            <p>HeyMetadata converts images directly inside your web browser using HTML5 Canvas and ImageBitmap APIs. When you select an image, the browser automatically detects its format and enables a dropdown to select your target format (JPG, JPEG, PNG, WebP, or AVIF). The image is re-encoded locally without sending any data over the network.</p>
          </div>
        </details>
        <details class="faq-item" name="faq">
          <summary>What is the difference between JPG and JPEG options?</summary>
          <div class="faq-answer">
            <p>JPG and JPEG use the exact same underlying JPEG image compression format, but some submission portals and government forms strictly require either a .jpg or .jpeg file extension. HeyMetadata lets you choose either extension directly.</p>
          </div>
        </details>
        <details class="faq-item" name="faq">
          <summary>Are my images uploaded to any server during conversion?</summary>
          <div class="faq-answer">
            <p>No. The entire conversion runs 100% client-side on your device. Your images are never uploaded, stored, or sent to any remote server or third party.</p>
          </div>
        </details>
        <details class="faq-item" name="faq">
          <summary>What image formats are supported for conversion?</summary>
          <div class="faq-answer">
            <p>We support dynamic conversions between JPG, JPEG, PNG, WebP, and AVIF formats: convert between any pair of formats including JPG to JPEG, JPEG to JPG, PNG to JPG/JPEG/WebP/AVIF, and AVIF to JPG/JPEG/PNG/WebP.</p>
          </div>
        </details>
        <details class="faq-item" name="faq">
          <summary>Does image conversion affect resolution or quality?</summary>
          <div class="faq-answer">
            <p>Original pixel dimensions are preserved exactly 1:1. For PNG output, conversion is lossless. For JPG, JPEG, WebP, and AVIF, high-fidelity encoding settings (92% quality default) are used to ensure sharp results without visual degradation.</p>
          </div>
        </details>
        <details class="faq-item" name="faq">
          <summary>What happens to transparent backgrounds when converting to JPG or JPEG?</summary>
          <div class="faq-answer">
            <p>Because JPEG format does not support transparency, transparent areas are automatically composited onto a clean white background during conversion.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- Footer -->
    <footer>
      <a class="brand" href="/" aria-label="HeyMetadata home">
        <span class="brand-mark">✦</span> HeyMetadata
      </a>
      <p>Free Online Privacy Tools — Metadata Remover &amp; Image Converter</p>
      <div class="footer-links">
        <a href="/">Metadata Remover</a>
        <a href="/convert">Image Converter</a>
        <a href="/about">About Us</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
        <a href="/contact">Contact Us</a>
      </div>
      <span>© 2026 HeyMetadata</span>
    </footer>
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(converterFaqSchema)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(converterAppSchema)}></script>

  <script>
    import {
      inspectImageFile,
      convertImage,
      getAvailableTargetFormats,
      formatBytes,
      type SupportedFormat,
      type ConversionResult,
    } from '../utils/imageConverter';

    // ── DOM References ───────────────────────────────────────────────────────────
    const input = document.querySelector('#file-input') as HTMLInputElement;
    const dropzone = document.querySelector('#dropzone') as HTMLElement;
    const browseBtn = document.querySelector('#browse-button') as HTMLButtonElement;
    const panel = document.querySelector('#file-panel') as HTMLElement;
    const converterCard = document.querySelector('#converter-card') as HTMLElement;
    const convertControls = document.querySelector('#convert-controls') as HTMLElement;
    const conversionResult = document.querySelector('#conversion-result') as HTMLElement;
    const statusText = document.querySelector('#converter-status') as HTMLElement;
    const convertBtn = document.querySelector('#convert-button') as HTMLButtonElement;
    const downloadBtn = document.querySelector('#download-button') as HTMLButtonElement;
    const resetBtn = document.querySelector('#reset-button') as HTMLButtonElement;
    const againBtn = document.querySelector('#again-button') as HTMLButtonElement;
    const dzHeading = document.querySelector('#dz-heading') as HTMLElement;
    const errorBanner = document.querySelector('#error-banner') as HTMLElement;
    const errorMessage = document.querySelector('#error-message') as HTMLElement;
    const errorClose = document.querySelector('#error-close') as HTMLButtonElement;
    const targetFormatSelect = document.querySelector('#target-format-select') as HTMLSelectElement;
    const detectedFormatText = document.querySelector('#detected-format-text') as HTMLElement;
    const qualitySelectorBlock = document.querySelector('#quality-selector-block') as HTMLElement;
    const qualitySlider = document.querySelector('#quality-slider') as HTMLInputElement;
    const qualityVal = document.querySelector('#quality-val') as HTMLElement;
    const sourcePreview = document.querySelector('#source-preview') as HTMLImageElement;
    const resultPreview = document.querySelector('#result-preview') as HTMLImageElement;

    // ── FAQ Accordion Exclusive Toggle ─────────────────────────────────────────
    const faqItems = document.querySelectorAll('.faq-item') as NodeListOf<HTMLDetailsElement>;
    faqItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open) {
          faqItems.forEach((otherItem) => {
            if (otherItem !== item && otherItem.open) {
              otherItem.open = false;
            }
          });
        }
      });
    });

    // ── State Variables ────────────────────────────────────────────────────────
    let currentFile: File | null = null;
    let currentSourceFormat: SupportedFormat | null = null;
    let selectedTargetFormat: SupportedFormat = 'png';
    let conversionOutput: ConversionResult | null = null;
    let sourcePreviewUrl: string | null = null;

    // ── Error Helper ───────────────────────────────────────────────────────────
    function showError(msg: string) {
      errorMessage.textContent = msg;
      errorBanner.hidden = false;
      statusText.textContent = 'Action failed';
    }

    function clearError() {
      errorBanner.hidden = true;
      errorMessage.textContent = '';
    }

    errorClose.addEventListener('click', clearError);

    // ── Quality Slider Listener ────────────────────────────────────────────────
    qualitySlider.addEventListener('input', () => {
      qualityVal.textContent = `${qualitySlider.value}%`;
    });

    // ── Populate "Convert to" Dropdown ─────────────────────────────────────────
    const formatLabels: Record<SupportedFormat, string> = {
      jpg: 'JPG (.jpg) — Universal Photo',
      jpeg: 'JPEG (.jpeg) — Universal Photo',
      png: 'PNG (.png) — Lossless Graphics',
      webp: 'WEBP (.webp) — Modern Web Format',
      avif: 'AVIF (.avif) — Advanced High-Efficiency Web Format',
    };

    function populateTargetDropdown(sourceFormat: SupportedFormat) {
      targetFormatSelect.innerHTML = '';
      const availableTargets = getAvailableTargetFormats(sourceFormat);

      if (availableTargets.length === 0) {
        showError(`No conversion formats available for ${sourceFormat.toUpperCase()}.`);
        targetFormatSelect.disabled = true;
        return;
      }

      targetFormatSelect.disabled = false;

      availableTargets.forEach((target, index) => {
        const option = document.createElement('option');
        option.value = target;
        option.textContent = formatLabels[target] || target.toUpperCase();
        if (index === 0) {
          option.selected = true;
          selectedTargetFormat = target;
        }
        targetFormatSelect.appendChild(option);
      });

      if (detectedFormatText) {
        detectedFormatText.textContent = sourceFormat.toUpperCase();
      }

      updateQualityVisibility();
    }

    targetFormatSelect.addEventListener('change', () => {
      selectedTargetFormat = targetFormatSelect.value as SupportedFormat;
      updateQualityVisibility();
    });

    function updateQualityVisibility() {
      // PNG is lossless; quality slider is only relevant for lossy JPG, JPEG, WebP, and AVIF
      if (selectedTargetFormat === 'png') {
        qualitySelectorBlock.style.opacity = '0.45';
        qualitySelectorBlock.style.pointerEvents = 'none';
        qualityVal.textContent = 'Lossless (100%)';
      } else {
        qualitySelectorBlock.style.opacity = '1';
        qualitySelectorBlock.style.pointerEvents = 'auto';
        qualityVal.textContent = `${qualitySlider.value}%`;
      }
    }

    // ── Smooth Scroll Helpers ──────────────────────────────────────────────────
    function scrollToConversionControls() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior: ScrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';

      requestAnimationFrame(() => {
        const controls = (document.querySelector('.format-selector-block') || convertControls) as HTMLElement;
        if (controls) {
          controls.scrollIntoView({ behavior, block: 'nearest', inline: 'nearest' });
        }
      });
    }

    function scrollToUploadCard() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior: ScrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';

      requestAnimationFrame(() => {
        const target = converterCard || dropzone;
        if (target) {
          target.scrollIntoView({ behavior, block: 'center', inline: 'nearest' });
        }
      });
    }

    // ── Main File Handler ──────────────────────────────────────────────────────
    async function handleFile(file: File | undefined) {
      clearError();
      if (!file) return;

      statusText.textContent = 'Reading image…';

      try {
        const metadata = await inspectImageFile(file);
        currentFile = file;
        currentSourceFormat = metadata.format;

        // Revoke previous source preview if any
        if (sourcePreviewUrl) {
          URL.revokeObjectURL(sourcePreviewUrl);
        }
        sourcePreviewUrl = URL.createObjectURL(file);
        sourcePreview.src = sourcePreviewUrl;

        // Update UI info
        document.querySelector('#file-name')!.textContent = metadata.name;
        document.querySelector('#file-size')!.textContent = formatBytes(metadata.size);
        document.querySelector('#file-dimensions')!.textContent = `${metadata.width} × ${metadata.height} px`;
        document.querySelector('#file-type')!.textContent = metadata.format.toUpperCase();

        // Dynamically populate output dropdown for this specific detected format
        populateTargetDropdown(metadata.format);

        // Switch panels
        dropzone.hidden = true;
        panel.hidden = false;
        convertControls.hidden = false;
        conversionResult.hidden = true;
        statusText.textContent = 'Ready to convert';

        // Automatically and smoothly scroll to the conversion controls
        scrollToConversionControls();
      } catch (err: any) {
        console.error(err);
        showError(err?.message || 'Failed to inspect the image.');
        statusText.textContent = 'Inspection failed';
      }
    }

    const progressBar = document.querySelector('#progress-bar') as HTMLElement;
    const progressFill = document.querySelector('#progress-fill') as HTMLElement;

    // ── Run Conversion ─────────────────────────────────────────────────────────
    async function executeConversion() {
      if (!currentFile || !currentSourceFormat) return;

      clearError();
      convertBtn.disabled = true;
      convertBtn.textContent = 'Converting image…';
      statusText.textContent = `Converting ${currentSourceFormat.toUpperCase()} to ${selectedTargetFormat.toUpperCase()}…`;
      if (progressBar) progressBar.hidden = false;
      if (progressFill) progressFill.style.width = '70%';

      try {
        const quality = parseInt(qualitySlider.value, 10) / 100;
        const result = await convertImage(currentFile, {
          targetFormat: selectedTargetFormat,
          quality,
        });

        if (progressFill) progressFill.style.width = '100%';
        conversionOutput = result;
        resultPreview.src = result.dataUrl;

        document.querySelector('#source-fmt-label')!.textContent = result.sourceFormat.toUpperCase();
        document.querySelector('#target-fmt-label')!.textContent = result.targetFormat.toUpperCase();
        document.querySelector('#before-size')!.textContent = formatBytes(currentFile.size);
        document.querySelector('#after-size')!.textContent = formatBytes(result.fileSize);
        document.querySelector('#download-ext-label')!.textContent = result.targetFormat.toUpperCase();
        document.querySelector('#result-copy')!.textContent = `Converted ${result.width} × ${result.height} px image to ${result.targetFormat.toUpperCase()} (${formatBytes(result.fileSize)}) entirely in your browser.`;

        convertControls.hidden = true;
        conversionResult.hidden = false;
        statusText.textContent = 'Conversion complete';
      } catch (err: any) {
        console.error(err);
        showError(err?.message || 'Conversion failed. Please try another image.');
        statusText.textContent = 'Conversion failed';
      } finally {
        if (progressBar) progressBar.hidden = true;
        if (progressFill) progressFill.style.width = '0%';
        convertBtn.disabled = false;
        convertBtn.innerHTML = 'Convert Image <span aria-hidden="true">→</span>';
      }
    }

    // ── Download Handler ───────────────────────────────────────────────────────
    function downloadResult() {
      if (!conversionOutput) return;
      const link = document.createElement('a');
      link.href = conversionOutput.dataUrl;
      link.download = conversionOutput.fileName;
      link.click();
    }

    // ── Reset Handler ──────────────────────────────────────────────────────────
    function resetAll() {
      input.value = '';
      currentFile = null;
      currentSourceFormat = null;
      if (sourcePreviewUrl) {
        URL.revokeObjectURL(sourcePreviewUrl);
        sourcePreviewUrl = null;
      }
      if (conversionOutput) {
        URL.revokeObjectURL(conversionOutput.dataUrl);
        conversionOutput = null;
      }
      targetFormatSelect.innerHTML = '';
      targetFormatSelect.disabled = true;
      clearError();
      panel.hidden = true;
      dropzone.hidden = false;
      statusText.textContent = 'Ready to convert';
    }

    // ── Event Listeners ────────────────────────────────────────────────────────
    convertBtn.addEventListener('click', executeConversion);
    downloadBtn.addEventListener('click', downloadResult);
    resetBtn.addEventListener('click', () => {
      resetAll();
      scrollToUploadCard();
    });
    againBtn.addEventListener('click', () => {
      resetAll();
      scrollToUploadCard();
    });

    // Dropzone interaction
    dropzone.addEventListener('click', (e) => {
      if (e.target === browseBtn || browseBtn.contains(e.target as Node)) return;
      input.click();
    });

    browseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      input.click();
    });

    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        handleFile(target.files[0]);
      }
    });

    let dragDepth = 0;
    dropzone.addEventListener('dragenter', (e) => {
      e.preventDefault();
      if (dragDepth === 0) {
        dropzone.classList.add('dragging');
        dzHeading.textContent = 'Drop your image here to convert';
      }
      dragDepth++;
    });

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
    });

    dropzone.addEventListener('dragleave', () => {
      dragDepth--;
      if (dragDepth === 0) {
        dropzone.classList.remove('dragging');
        dzHeading.textContent = 'Drop a JPG, JPEG, PNG, WebP, or AVIF image to convert';
      }
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dragDepth = 0;
      dropzone.classList.remove('dragging');
      dzHeading.textContent = 'Drop a JPG, JPEG, PNG, WebP, or AVIF image to convert';
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        input.click();
      }
    });

    // ── Dark mode toggle ──────────────────────────────────────────────────────
    (function () {
      const html = document.documentElement;
      const btn = document.querySelector('#theme-toggle');
      const KEY = 'mc-theme';
      if (!btn) return;

      function applyTheme(dark: boolean) {
        html.classList.toggle('dark', dark);
        btn!.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        try { localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch {}
      }

      const stored = (() => { try { return localStorage.getItem(KEY); } catch { return null; } })();
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      applyTheme(stored === 'dark' || (stored === null && prefersDark));

      btn.addEventListener('click', () => applyTheme(!html.classList.contains('dark')));

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        try { if (!localStorage.getItem(KEY)) applyTheme(e.matches); } catch { applyTheme(e.matches); }
      });
    })();
  </script>
</Layout>

<style>
/* ── Design tokens ─────────────────────────────────────────────────────────── */
