---
interface Props { title?: string }
const { title = 'MetaClean' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#ffffff" /><meta name="description" content="Inspect and remove metadata from images and PDFs in your browser." /><link rel="icon" href="/favicon.ico" /><title>{title}</title><script is:inline>try{const t=localStorage.getItem('mc-theme');if(t!=='light')document.documentElement.classList.add('dark')}catch{}</script></head><body><a class="skip-link" href="#cleaner">Skip to file cleaner</a><slot /></body></html>
<style is:global>html,body{margin:0;min-width:320px}button,input{font:inherit}::selection{background:#171717;color:#fff}.skip-link{position:fixed;z-index:10;left:12px;top:-50px;background:#171717;color:#fff;padding:9px 12px;border-radius:6px}.skip-link:focus{top:12px}body{background:#fff;transition:background-color .3s}html.dark body{background:#0d0f14}</style>
